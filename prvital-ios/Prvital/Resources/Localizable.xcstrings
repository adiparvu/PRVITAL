    "Reminders are delivered by the system as local notifications. Grant permission once so scheduled reminders can appear.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen werden vom System als lokale Mitteilungen zugestellt. Die Berechtigung einmal gewähren, damit geplante Erinnerungen erscheinen können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recordatorios los entrega el sistema como notificaciones locales. Concede el permiso una vez para que los recordatorios programados puedan aparecer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels sont diffusés par le système sous forme de notifications locales. Accordez l'autorisation une fois pour que les rappels programmés puissent apparaître."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I promemoria vengono inviati dal sistema come notifiche locali. Concedi l'autorizzazione una volta affinché i promemoria programmati possano apparire."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herinneringen worden door het systeem geleverd als lokale meldingen. Geef eenmalig toestemming zodat geplande herinneringen kunnen verschijnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypomnienia są dostarczane przez system jako lokalne powiadomienia. Przyznaj uprawnienie raz, aby zaplanowane przypomnienia mogły się pojawiać."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os lembretes são entregues pelo sistema como notificações locais. Concede a permissão uma vez para que os lembretes agendados possam aparecer."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Reamintirile sunt livrate de sistem ca notificări locale. Acordă permisiunea o dată pentru ca reamintirile programate să poată apărea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминания доставляются системой как локальные уведомления. Предоставьте разрешение один раз, чтобы запланированные напоминания могли появляться."
          }
        }
      }
    },
