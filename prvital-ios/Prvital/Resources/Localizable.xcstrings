    "Sensor data was sparse across that period, so treat the estimate loosely." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für diesen Zeitraum lagen nur wenige Sensordaten vor, behandle die Schätzung daher mit Vorsicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos del sensor fueron escasos en ese periodo, así que toma la estimación con cautela."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données du capteur étaient limitées sur cette période, alors considère cette estimation avec prudence."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dati del sensore erano scarsi in quel periodo, quindi considera la stima come indicativa."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er waren weinig sensorgegevens beschikbaar in die periode, dus beschouw de schatting als een ruwe indicatie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dane z sensora były w tym okresie niepełne, więc traktuj ten szacunek z ostrożnością."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dados do sensor foram escassos nesse período, por isso considera a estimativa com alguma reserva."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datele senzorului au fost puține în această perioadă, așa că tratează estimarea cu rezervă."
