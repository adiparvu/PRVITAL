        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ежедневное напоминание о дозе инсулина длительного действия."
          }
        }
      }
    },
    "A few details so Prvital speaks your numbers. You can change any of this later in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein paar Angaben, damit Prvital deine Zahlen spricht. Alles lässt sich später in den Einstellungen ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unos pocos datos para que Prvital hable tus números. Puedes cambiar todo esto más tarde en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelques détails pour que Prvital parle vos chiffres. Vous pourrez tout modifier plus tard dans les Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualche dettaglio perché Prvital parli i tuoi numeri. Puoi cambiare tutto in seguito nelle Impostazioni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een paar gegevens zodat Prvital jouw cijfers spreekt. Je kunt dit later allemaal wijzigen in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilka szczegółów, aby Prvital mówił Twoimi liczbami. Wszystko można później zmienić w Ustawieniach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns detalhes para que o Prvital fale os teus números. Podes alterar tudo isto mais tarde nas Definições."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Câteva detalii pentru ca Prvital să vorbească în cifrele tale. Poți schimba orice mai târziu în Setări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Несколько деталей, чтобы Prvital говорил на языке ваших цифр. Всё это можно изменить позже в настройках."
          }
        }
      }
    },
    "A gentle nudge to log how you're doing.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein sanfter Anstoß, das Befinden festzuhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un suave recordatorio para anotar cómo te encuentras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un petit rappel pour noter comment vous vous sentez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un delicato invito a registrare come stai."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een vriendelijk duwtje om te noteren hoe het met je gaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Delikatne przypomnienie, aby zanotować, jak się czujesz."
          }
        },
        "pt": {
          "stringUnit": {
