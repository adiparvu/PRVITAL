          }
        }
      }
    },
    "A glucose below 70 mg/dL (3.9 mmol/L) is a low. Below 54 mg/dL (3.0 mmol/L) is a serious low that needs immediate treatment." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Glukosewert unter 70 mg/dL (3.9 mmol/L) gilt als niedrig. Unter 54 mg/dL (3.0 mmol/L) handelt es sich um eine schwere Unterzuckerung, die sofort behandelt werden muss."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una glucosa por debajo de 70 mg/dL (3.9 mmol/L) es un nivel bajo. Por debajo de 54 mg/dL (3.0 mmol/L) es un nivel bajo grave que necesita tratamiento inmediato."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une glycémie inférieure à 70 mg/dL (3.9 mmol/L) est une hypo. En dessous de 54 mg/dL (3.0 mmol/L), c'est une hypo sévère qui nécessite un traitement immédiat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una glicemia inferiore a 70 mg/dL (3.9 mmol/L) è un'ipoglicemia. Sotto i 54 mg/dL (3.0 mmol/L) si tratta di un'ipoglicemia grave che richiede un trattamento immediato."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een glucose onder 70 mg/dL (3.9 mmol/L) is een lage waarde. Onder 54 mg/dL (3.0 mmol/L) is een ernstige lage waarde die direct behandeld moet worden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glikemia poniżej 70 mg/dL (3,9 mmol/L) to niedocukrzenie. Poniżej 54 mg/dL (3,0 mmol/L) to poważne niedocukrzenie wymagające natychmiastowego leczenia."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma glicose abaixo de 70 mg/dL (3.9 mmol/L) é uma hipoglicemia. Abaixo de 54 mg/dL (3.0 mmol/L) é uma hipoglicemia grave que precisa de tratamento imediato."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O glicemie sub 70 mg/dL (3.9 mmol/L) reprezintă o hipoglicemie. Sub 54 mg/dL (3.0 mmol/L) este o hipoglicemie severă care necesită tratament imediat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Глюкоза ниже 70 mg/dL (3.9 mmol/L) — это низкий уровень. Ниже 54 mg/dL (3.0 mmol/L) — серьёзный низкий уровень, который требует немедленного лечения."
          }
        }
      }
    },
