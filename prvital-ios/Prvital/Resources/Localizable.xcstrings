    "Values are stored in mg/dL and converted for display. Switching units never changes your data.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werte werden in mg/dL gespeichert und für die Anzeige umgerechnet. Ein Wechsel der Einheiten ändert nie die Daten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los valores se almacenan en mg/dL y se convierten para su visualización. Cambiar de unidad nunca modifica tus datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les valeurs sont stockées en mg/dL et converties pour l'affichage. Changer d'unité ne modifie jamais vos données."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I valori sono memorizzati in mg/dL e convertiti per la visualizzazione. Cambiare unità non modifica mai i tuoi dati."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waarden worden opgeslagen in mg/dL en omgerekend voor weergave. Het wisselen van eenheden verandert je gegevens nooit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartości są przechowywane w mg/dL i przeliczane do wyświetlania. Zmiana jednostek nigdy nie zmienia Twoich danych."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os valores são armazenados em mg/dL e convertidos para apresentação. Mudar de unidade nunca altera os teus dados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Valorile sunt stocate în mg/dL și convertite pentru afișare. Schimbarea unităților nu îți modifică niciodată datele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значения хранятся в mg/dL и преобразуются для отображения. Переключение единиц никогда не изменяет ваши данные."
          }
        }
      }
    },
