    "Highs took up %lld%% of the %@ — a spot to look at meals or timing." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hohe Werte machten %lld%% (%@) aus — ein guter Ansatzpunkt, um Mahlzeiten oder Timing zu überprüfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los picos altos ocuparon el %lld%% del %@ — un punto a revisar en las comidas o los horarios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les hyperglycémies ont représenté %lld%% sur ta période (%@) — un point à surveiller côté repas ou horaires."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le iperglicemie hanno occupato il %lld%% di %@ — un aspetto su cui rivedere pasti o tempistiche."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoge waarden namen %lld%% van de %@ in beslag — een goed punt om naar maaltijden of timing te kijken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysokie wartości zajęły %lld%% przez ostatni %@ — warto przyjrzeć się posiłkom lub ich porom."
