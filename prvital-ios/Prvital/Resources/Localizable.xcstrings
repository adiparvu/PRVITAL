    "Stay until I'm fully recovered or help arrives.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleiben Sie, bis es mir wieder ganz gut geht oder Hilfe eintrifft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quédate hasta que me recupere del todo o llegue la ayuda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restez jusqu'à ce que je sois complètement rétabli ou que les secours arrivent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Restate finché non mi sono ripreso del tutto o finché non arrivano i soccorsi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blijf tot ik volledig hersteld ben of er hulp komt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostań, aż w pełni dojdę do siebie lub przyjedzie pomoc."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fique até eu recuperar totalmente ou até chegar ajuda."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rămâi până îmi revin complet sau până sosește ajutorul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставайтесь рядом, пока я полностью не приду в себя или не прибудет помощь."
          }
        }
      }
    },
    "Stay with me": {
