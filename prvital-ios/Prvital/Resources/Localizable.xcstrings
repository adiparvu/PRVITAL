    "Barcode scanning needs a device with a camera. Search by name instead.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für das Scannen von Barcodes ist ein Gerät mit Kamera erforderlich. Stattdessen nach Namen suchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El escaneo de códigos de barras requiere un dispositivo con cámara. Busca por nombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scan de code-barres nécessite un appareil doté d'un appareil photo. Recherchez plutôt par nom."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scansione del codice a barre richiede un dispositivo con fotocamera. Cerca invece per nome."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Barcodes scannen vereist een apparaat met een camera. Zoek in plaats daarvan op naam."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skanowanie kodów kreskowych wymaga urządzenia z aparatem. Zamiast tego wyszukaj po nazwie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A digitalização de códigos de barras requer um dispositivo com câmara. Em alternativa, pesquise pelo nome."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanarea codurilor de bare are nevoie de un dispozitiv cu cameră. Caută după nume în schimb."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для сканирования штрихкодов нужно устройство с камерой. Вместо этого выполните поиск по названию."
          }
        }
      }
    },
