      }
    },
    "What's on your mind?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was beschäftigt dich?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué tienes en mente?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'avez-vous en tête ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A cosa stai pensando?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat houdt je bezig?"
          }
        },
        "pl": {
          "stringUnit": {
