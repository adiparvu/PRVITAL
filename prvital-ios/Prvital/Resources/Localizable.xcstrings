    "Sync CGM readings from your own Nightscout site over the internet — no vendor account required.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CGM-Messwerte vom eigenen Nightscout-Server über das Internet synchronisieren — kein Herstellerkonto erforderlich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincroniza las lecturas del CGM desde tu propio sitio Nightscout por internet — sin necesidad de una cuenta de proveedor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisez les mesures CGM depuis votre propre site Nightscout via Internet — aucun compte fournisseur requis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizza le letture CGM dal tuo sito Nightscout tramite internet — nessun account del fornitore richiesto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchroniseer CGM-metingen van je eigen Nightscout-site via internet — geen leveranciersaccount vereist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizuj odczyty CGM z własnej witryny Nightscout przez internet — bez konta u dostawcy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincroniza as leituras CGM do teu próprio site Nightscout através da internet — não é necessária uma conta de fornecedor."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizează citirile CGM de pe propriul site Nightscout prin internet — fără cont de furnizor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизируйте измерения CGM с вашего собственного сайта Nightscout через интернет — учётная запись поставщика не требуется."
          }
        }
      }
    },
    "Sync uses only your own private iCloud — off until you enable it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Synchronisierung nutzt nur deine eigene private iCloud – aus, bis du sie aktivierst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización usa solo tu propia iCloud privada: desactivada hasta que la actives."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation utilise uniquement votre propre iCloud privé — désactivée tant que vous ne l'activez pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronizzazione usa solo il tuo iCloud privato — disattivata finché non la abiliti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisatie gebruikt alleen je eigen privé-iCloud — uit totdat je het inschakelt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizacja korzysta wyłącznie z Twojego prywatnego iCloud — wyłączona, dopóki jej nie włączysz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A sincronização usa apenas o teu iCloud privado — desativada até a ativares."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizarea folosește doar propriul tău iCloud privat — dezactivată până o activezi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизация использует только ваш личный iCloud — отключена, пока вы её не включите."
          }
        }
      }
    },
