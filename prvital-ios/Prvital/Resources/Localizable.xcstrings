    "Sign in with your Dexcom account to import readings through Dexcom Share (the Dexcom Follow service). Choose the region that matches your account.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich mit deinem Dexcom-Konto an, um Messwerte über Dexcom Share (den Dexcom-Follow-Dienst) zu importieren. Wähle die Region, die zu deinem Konto passt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión con tu cuenta de Dexcom para importar lecturas a través de Dexcom Share (el servicio Dexcom Follow). Elige la región que coincida con tu cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous avec votre compte Dexcom pour importer des mesures via Dexcom Share (le service Dexcom Follow). Choisissez la région correspondant à votre compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi con il tuo account Dexcom per importare le letture tramite Dexcom Share (il servizio Dexcom Follow). Scegli la regione corrispondente al tuo account."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meld je aan met je Dexcom-account om metingen te importeren via Dexcom Share (de Dexcom Follow-service). Kies de regio die bij je account past."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloguj się na koncie Dexcom, aby importować odczyty przez Dexcom Share (usługę Dexcom Follow). Wybierz region zgodny z Twoim kontem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sessão com a tua conta Dexcom para importar leituras através do Dexcom Share (o serviço Dexcom Follow). Escolhe a região que corresponde à tua conta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentifică-te cu contul tău Dexcom pentru a importa citiri prin Dexcom Share (serviciul Dexcom Follow). Alege regiunea care corespunde contului tău."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите с помощью аккаунта Dexcom, чтобы импортировать измерения через Dexcom Share (сервис Dexcom Follow). Выберите регион, соответствующий вашему аккаунту."
          }
        }
      }
    },
    "Sign in with your LibreLinkUp account and share a sensor to import readings. Region is detected automatically.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich mit deinem LibreLinkUp-Konto an und teile einen Sensor, um Messwerte zu importieren. Die Region wird automatisch erkannt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión con tu cuenta de LibreLinkUp y comparte un sensor para importar lecturas. La región se detecta automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous avec votre compte LibreLinkUp et partagez un capteur pour importer des mesures. La région est détectée automatiquement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi con il tuo account LibreLinkUp e condividi un sensore per importare le letture. La regione viene rilevata automaticamente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meld je aan met je LibreLinkUp-account en deel een sensor om metingen te importeren. De regio wordt automatisch gedetecteerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloguj się na koncie LibreLinkUp i udostępnij sensor, aby importować odczyty. Region jest wykrywany automatycznie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sessão com a tua conta LibreLinkUp e partilha um sensor para importar leituras. A região é detetada automaticamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentifică-te cu contul tău LibreLinkUp și partajează un senzor pentru a importa citiri. Regiunea este detectată automat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите с помощью аккаунта LibreLinkUp и предоставьте доступ к сенсору, чтобы импортировать измерения. Регион определяется автоматически."
          }
        }
      }
    },
    "Signed in": {
      "extractionState": "manual",
      "localizations": {
