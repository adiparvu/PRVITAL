    "You spent %lld%% below range. Easing off lows is usually the first win." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du warst zu %lld%% unterhalb des Zielbereichs. Weniger Unterzuckerungen zu haben ist meist der erste Erfolg."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasaste el %lld%% por debajo del rango. Reducir las bajadas suele ser el primer logro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as passé %lld%% de ton temps sous la cible. Réduire les hypoglycémies est souvent la première victoire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai trascorso il %lld%% sotto il range. Ridurre le ipoglicemie è di solito il primo traguardo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je zat %lld%% van de tijd onder bereik. Minder lage waarden is meestal de eerste overwinning."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld%% czasu poniżej zakresu. Ograniczenie niedocukrzeń to zwykle pierwszy sukces."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passaste %lld%% do tempo abaixo do intervalo. Reduzir as hipoglicemias costuma ser a primeira vitória."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ai petrecut %lld%% sub interval țintă. De obicei, primul progres e reducerea episoadelor de glicemie scăzută."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы провели %lld%% времени ниже целевого диапазона. Снижение числа гипогликемий обычно становится первой победой."
          }
        }
      }
    },
    "You still have %@ U working — most of this meal is already covered." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wirken noch %@ E — der Großteil dieser Mahlzeit ist schon abgedeckt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún tienes %@ U activas — la mayor parte de esta comida ya está cubierta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il te reste %@ U actives — l'essentiel de ce repas est déjà couvert."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai ancora %@ U attive — gran parte di questo pasto è già coperta."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er werkt nog %@ E — het grootste deel van deze maaltijd is al gedekt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadal działa %@ j. — większość tego posiłku jest już pokryta."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda tens %@ U ativas — a maior parte desta refeição já está coberta."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mai ai %@ U active — cea mai mare parte a acestei mese e deja acoperită."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ещё действует %@ ед. — большая часть этой еды уже покрыта."
          }
        }
      }
    },
    "You tend to run high overnight. Dinner timing and size, or your basal, may be worth reviewing with your team." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nachts sind deine Werte tendenziell hoch. Der Zeitpunkt und die Menge deines Abendessens oder dein Basalinsulin sind es wert, mit deinem Team besprochen zu werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiendes a subir por la noche. Puede valer la pena revisar con tu equipo el horario y la cantidad de la cena, o tu basal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as tendance à être élevé la nuit. Le moment et la taille du dîner, ou ton débit de base, méritent peut-être d'être revus avec ton équipe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante la notte tendi ad avere valori alti. L'orario e la quantità della cena, o la tua basale, potrebbero valere una revisione con il tuo team."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt de neiging om 's nachts hoog te zitten. De timing en hoeveelheid van je avondeten, of je basaal, zijn wellicht de moeite waard om met je team te bekijken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W nocy zwykle masz podwyższony poziom. Warto porozmawiać ze swoim zespołem opieki o porze i wielkości kolacji albo o swojej bazie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tua glicemia tende a ficar alta durante a noite. Pode valer a pena rever com a tua equipa o horário e a quantidade do jantar, ou a tua basal."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinzi să ai valori ridicate peste noapte. Momentul și mărimea cinei, sau doza bazală, ar putea merita revizuite împreună cu echipa ta medicală."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По ночам у тебя обычно повышенная глюкоза. Возможно, стоит пересмотреть со своей командой время и объём ужина или базальную дозу."
          }
        }
      }
    },
    "You were in range %lld%% of the %@ — at or above your %lld%% goal. Well done." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du warst zu %lld%% im Zielbereich (%@) — das erreicht oder übertrifft dein %lld%%-Ziel. Gut gemacht!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estuviste en rango el %lld%% del %@ — igual o por encima de tu meta del %lld%%. Muy bien hecho."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu es resté(e) dans la cible %lld%% sur ta période (%@) — à la hauteur ou au-dessus de ton objectif de %lld%%. Bravo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei stato in range per il %lld%% di %@ — al livello del tuo obiettivo del %lld%% o superiore. Ottimo lavoro."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je zat %lld%% van de %@ binnen bereik — op of boven je doel van %lld%%. Goed gedaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld%% w zakresie przez ostatni %@ — na poziomie lub powyżej Twojego celu %lld%%. Brawo."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estiveste dentro do intervalo em %lld%% do período (%@) — na tua meta de %lld%% ou mais. Muito bem."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ai fost în interval țintă %lld%% din %@ — la nivelul sau peste obiectivul tău de %lld%%. Bravo!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы были в целевом диапазоне %lld%% времени за %@ — на уровне цели %lld%% или выше. Отлично!"
          }
        }
      }
    },
    "You were in range %lld%% of the %@, just shy of your %lld%% goal — really close." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du warst zu %lld%% im Zielbereich (%@), knapp unter deinem %lld%%-Ziel — ganz nah dran."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estuviste en rango el %lld%% del %@, muy cerca de tu meta del %lld%% — casi lo logras."
          }
        },
        "fr" : {
