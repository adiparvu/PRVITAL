    "Favorite meals, one-tap presets and the quick-entry hub get glucose, insulin, carbs and activity into your journal in seconds.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lieblingsmahlzeiten, Ein-Tipp-Voreinstellungen und die Schnelleingabe bringen Glukose, Insulin, Kohlenhydrate und Aktivität in Sekunden in dein Journal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las comidas favoritas, los preajustes de un toque y el centro de entrada rápida meten glucosa, insulina, carbohidratos y actividad en tu diario en segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Repas favoris, préréglages à une touche et pôle de saisie rapide : glycémie, insuline, glucides et activité rejoignent votre journal en quelques secondes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasti preferiti, preset a un tocco e l'hub di inserimento rapido portano glicemia, insulina, carboidrati e attività nel tuo diario in pochi secondi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Favoriete maaltijden, presets met één tik en de snelle invoerhub zetten glucose, insuline, koolhydraten en activiteit binnen seconden in je dagboek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulubione posiłki, gotowe ustawienia na jedno dotknięcie i centrum szybkiego wpisu dodają glukozę, insulinę, węglowodany i aktywność do Twojego dziennika w kilka sekund."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As refeições favoritas, as predefinições de um toque e o centro de registo rápido põem glicose, insulina, hidratos de carbono e atividade no teu diário em segundos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesele favorite, presetările cu o atingere și centrul de introducere rapidă aduc glicemia, insulina, carbohidrații și activitatea în jurnalul tău în câteva secunde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Любимые приёмы пищи, пресеты в одно касание и центр быстрого ввода добавляют глюкозу, инсулин, углеводы и активность в ваш дневник за секунды."
          }
        }
      }
    },
