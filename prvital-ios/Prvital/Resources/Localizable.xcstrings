    "Afternoon" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nachmittag"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarde"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après-midi"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomeriggio"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Middag"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Popołudnie"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarde"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "După-amiaza"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "День"
          }
        }
      }
    },
    "Afternoon lows show up often. Daytime activity or a lighter lunch dose may be a factor — a small tweak can smooth it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nachmittags kommt es häufig zu niedrigen Werten. Aktivität tagsüber oder eine kleinere Mittagsdosis könnten eine Rolle spielen — eine kleine Anpassung kann das ausgleichen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las bajadas por la tarde son frecuentes. La actividad durante el día o una dosis de almuerzo más ligera pueden influir — un pequeño ajuste puede suavizarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les hypos de l'après-midi reviennent souvent. L'activité en journée ou une dose de déjeuner plus légère peuvent en être la cause — un petit ajustement peut lisser ça."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I cali pomeridiani si presentano spesso. L'attività diurna o una dose di pranzo più leggera potrebbero essere un fattore — una piccola modifica può renderlo più regolare."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lage waarden in de middag komen vaak voor. Activiteit overdag of een lagere lunchdosis kan hierin meespelen — een kleine aanpassing kan dit verbeteren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Popołudniowe spadki zdarzają się często. Może mieć na to wpływ aktywność w ciągu dnia lub mniejsza dawka na obiad — drobna zmiana może to wygładzić."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As hipoglicemias à tarde são frequentes. A atividade durante o dia ou uma dose de almoço mais baixa podem ser um fator — um pequeno ajuste pode suavizar isto."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hipoglicemiile de după-amiază apar des. Activitatea din timpul zilei sau o doză mai mică la prânz pot fi un factor — un mic ajustaj poate netezi asta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дневные понижения случаются часто. Причиной может быть дневная активность или облегчённая доза на обед — небольшая корректировка поможет сгладить это."
          }
        }
      }
    },
    "Afternoons trend high. Bolusing a little earlier before lunch can blunt the spike." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nachmittags tendieren die Werte nach oben. Etwas früher vor dem Mittagessen zu bolusieren kann den Anstieg abschwächen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las tardes tienden a subir. Aplicar el bolo un poco antes del almuerzo puede atenuar el pico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les après-midis ont tendance à être élevés. Faire le bolus un peu plus tôt avant le déjeuner peut atténuer le pic."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I pomeriggi tendono a essere alti. Fare il bolo un po' prima di pranzo può attenuare il picco."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Middagen neigen naar hoge waarden. Iets eerder bolussen voor de lunch kan de piek afzwakken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Popołudniami poziom bywa podwyższony. Podanie bolusa nieco wcześniej przed obiadem może złagodzić skok."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As tardes tendem a ficar altas. Fazer o bólus um pouco mais cedo antes do almoço pode atenuar o pico."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "După-amiezile tind să fie ridicate. Administrarea bolusului cu puțin timp înainte de prânz poate atenua vârful."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После обеда глюкоза обычно повышена. Более ранний болюс перед обедом может смягчить скачок."
          }
        }
      }
    },
    "Aim for a different — often tighter — range while you sleep. It applies to the chart's target band and your Time-in-Range during those hours." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziele im Schlaf einen anderen — oft engeren — Bereich an. Er gilt für das Zielband im Diagramm und deine Zeit im Zielbereich während dieser Stunden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apunta a un rango diferente —a menudo más estrecho— mientras duermes. Se aplica a la banda objetivo del gráfico y a tu tiempo en rango durante esas horas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visez une plage différente — souvent plus étroite — pendant votre sommeil. Elle s'applique à la bande cible du graphique et à votre temps dans la cible durant ces heures."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punta a un intervallo diverso — spesso più stretto — mentre dormi. Si applica alla banda obiettivo del grafico e al tuo tempo nell'intervallo durante quelle ore."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streef tijdens je slaap naar een ander — vaak strakker — bereik. Het geldt voor de doelband in de grafiek en je tijd binnen bereik gedurende die uren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W trakcie snu dąż do innego — często węższego — zakresu. Dotyczy on docelowego pasma na wykresie oraz Twojego czasu w zakresie w tych godzinach."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procura um intervalo diferente — muitas vezes mais apertado — enquanto dormes. Aplica-se à banda-alvo do gráfico e ao teu tempo dentro do intervalo durante essas horas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urmărește un interval diferit — adesea mai strâns — în timpul somnului. Se aplică benzii-țintă din grafic și timpului tău în interval în acele ore."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стремитесь к другому — часто более узкому — диапазону во время сна. Он применяется к целевой зоне на графике и вашему времени в диапазоне в эти часы."
          }
        }
      }
    },
