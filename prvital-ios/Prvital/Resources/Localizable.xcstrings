    "Remember that glucose can keep falling for hours after exercise, including overnight." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denk daran, dass der Glukosewert nach dem Sport noch stundenlang weiter fallen kann — auch über Nacht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recuerda que la glucosa puede seguir bajando durante horas después del ejercicio, incluso durante la noche."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N'oublie pas que la glycémie peut continuer à baisser pendant plusieurs heures après l'effort, y compris pendant la nuit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricorda che la glicemia può continuare a scendere per ore dopo l'esercizio fisico, anche durante la notte."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedenk dat je glucose na het sporten nog uren kan blijven dalen, ook 's nachts."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pamiętaj, że glikemia może nadal spadać jeszcze przez wiele godzin po wysiłku, także w nocy."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lembra-te de que a glicose pode continuar a descer durante horas depois do exercício, incluindo durante a noite."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ține minte că glicemia poate continua să scadă timp de ore după efort fizic, inclusiv peste noapte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Помни, что глюкоза может продолжать снижаться ещё несколько часов после нагрузки, в том числе ночью."
          }
        }
      }
    },
    "Remember to log carbs and any bolus." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daran denken, Kohlenhydrate und einen etwaigen Bolus zu erfassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recuerda anotar los carbohidratos y cualquier bolo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
