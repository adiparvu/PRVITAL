            "state": "translated",
            "value": "Nulla viene usato per addestrare modelli finché non lo attivi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wordt niets gebruikt om modellen te trainen tenzij je het inschakelt."
