    "High ketones. Seek urgent medical care, especially with vomiting, belly pain, or trouble breathing.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hohe Ketonwerte. Suche dringend ärztliche Hilfe, besonders bei Erbrechen, Bauchschmerzen oder Atembeschwerden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cetonas altas. Busca atención médica urgente, sobre todo si hay vómitos, dolor abdominal o dificultad para respirar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cétones élevées. Consulte en urgence, surtout en cas de vomissements, de douleurs abdominales ou de difficultés respiratoires."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chetoni alti. Rivolgiti urgentemente a un medico, soprattutto in caso di vomito, dolore addominale o difficoltà respiratorie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoge ketonen. Zoek dringend medische hulp, vooral bij braken, buikpijn of ademhalingsproblemen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysoki poziom ketonów. Pilnie skorzystaj z pomocy medycznej, zwłaszcza jeśli towarzyszą temu wymioty, ból brzucha lub trudności z oddychaniem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cetonas elevadas. Procura cuidados médicos urgentes, especialmente se tiveres vómitos, dor abdominal ou dificuldade em respirar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cetone ridicate. Solicită asistență medicală de urgență, mai ales dacă apar vărsături, dureri de burtă sau dificultăți de respirație."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Высокий уровень кетонов. Срочно обратись за медицинской помощью, особенно при рвоте, боли в животе или затруднённом дыхании."
          }
        }
      }
    },
