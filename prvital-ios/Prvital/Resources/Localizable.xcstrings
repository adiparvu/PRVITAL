    "A little low right now — treat it and you'll be back on track.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerade etwas niedrig — behandle es und du bist wieder auf Kurs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un poco bajo ahora mismo — trátalo y volverás a estar en marcha."
          }
        },
        "fr": {
          "stringUnit": {
