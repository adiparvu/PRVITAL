    "Your glucose bounces around a fair bit. Consistent meal timing and pre-bolusing a few minutes before eating tend to steady it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Glukosewert schwankt ziemlich stark. Regelmäßige Essenszeiten und ein Vorab-Bolus einige Minuten vor dem Essen tragen dazu bei, ihn zu stabilisieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu glucosa varía bastante. Mantener un horario de comidas constante y aplicar el bolo unos minutos antes de comer suele estabilizarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta glycémie varie pas mal. Des horaires de repas réguliers et un bolus anticipé de quelques minutes avant de manger ont tendance à la stabiliser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua glicemia oscilla parecchio. Orari dei pasti regolari e il bolo anticipato di qualche minuto prima di mangiare tendono a stabilizzarla."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je glucose schommelt behoorlijk. Consistente maaltijdtijden en een paar minuten van tevoren bolussen helpen dit vaak te stabiliseren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja glikemia dość mocno się waha. Regularne pory posiłków i podawanie bolusa kilka minut przed jedzeniem zwykle to stabilizują."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tua glicemia oscila bastante. Manter horários de refeição consistentes e fazer o bólus uns minutos antes de comeres tende a torná-la mais estável."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glicemia ta variază destul de mult. Un program constant al meselor și administrarea bolusului cu câteva minute înainte de a mânca tind să o stabilizeze."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твоя глюкоза довольно сильно колеблется. Стабильное время приёмов пищи и болюс за несколько минут до еды обычно помогают её выровнять."
          }
        }
      }
    },
