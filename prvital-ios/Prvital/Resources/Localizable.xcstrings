    "Around %@ lately. Checking ketones and reviewing sick-day steps can help." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In letzter Zeit etwa %@. Ketone zu prüfen und die Schritte für Kranktheitstage durchzugehen, kann helfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Últimamente rondas %@. Comprobar las cetonas y repasar los pasos para días de enfermedad puede ayudar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces derniers temps, autour de %@. Vérifier les cétones et revoir les étapes des jours de maladie peut aider."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ultimamente intorno a %@. Controllare i chetoni e rivedere i passaggi per i giorni di malattia può aiutare."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De laatste tijd rond %@. Ketonen controleren en de ziektedag-stappen doornemen kan helpen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostatnio około %@. Pomocne może być sprawdzenie ketonów i przejrzenie kroków na dni choroby."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ultimamente por volta de %@. Verificar as cetonas e rever os passos para dias de doença pode ajudar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "În ultima vreme în jur de %@. Verificarea cetonelor și recitirea pașilor pentru zilele de boală te pot ajuta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В последнее время около %@. Проверка кетонов и повторение шагов на дни болезни могут помочь."
          }
        }
      }
    },
    "Asia" : {
      "extractionState" : "manual",
