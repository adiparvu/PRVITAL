    "Wait 15 minutes. Don't eat more straight away, even though you may feel like it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warte 15 Minuten. Iss nicht sofort mehr, auch wenn du das Gefühl hast, es zu brauchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espera 15 minutos. No comas más de inmediato, aunque te apetezca."
