    "Log glucose, insulin, meals, activity and notes — they'll appear here on your timeline.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Glukose, Insulin, Mahlzeiten, Aktivität und Notizen erfassen — sie erscheinen hier in der Zeitleiste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota glucosa, insulina, comidas, actividad y notas — aparecerán aquí en tu cronología."
