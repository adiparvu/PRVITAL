    "A short name for this meal, e.g. \\\"Usual breakfast\\\".": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A short name for this meal, e.g. \\\"Usual breakfast\\\"."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nume scurt pentru această masă, de ex. „Micul dejun obișnuit”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein kurzer Name für diese Mahlzeit, z. B. „Übliches Frühstück“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nombre corto para esta comida, p. ej. «Desayuno habitual»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nom court pour ce repas, par ex. « Petit-déjeuner habituel »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nome breve per questo pasto, ad es. \"Colazione solita\"."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een korte naam voor deze maaltijd, bijv. \"Gewoon ontbijt\"."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krótka nazwa tego posiłku, np. „Zwykłe śniadanie”."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um nome curto para esta refeição, p. ex. \"Pequeno-almoço habitual\"."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Короткое название блюда, например «Обычный завтрак»."
          }
        }
      }
    },
    "A soft, static wash of colour.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A soft, static wash of colour."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un văl fin și static de culoare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein sanfter, statischer Farbschleier."
          }
        },
        "es": {
