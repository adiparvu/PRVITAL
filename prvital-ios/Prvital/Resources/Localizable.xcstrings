    "Defaults follow the international consensus: a 70–180 mg/dL target with 54 and 250 marking severe lows and highs.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Standardwerte folgen dem internationalen Konsens: ein Zielbereich von 70–180 mg/dL, wobei 54 und 250 schwere Tief- und Hochwerte markieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los valores predeterminados siguen el consenso internacional: un objetivo de 70–180 mg/dL, con 54 y 250 marcando las hipoglucemias e hiperglucemias graves."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les valeurs par défaut suivent le consensus international : une cible de 70–180 mg/dL, avec 54 et 250 marquant les hypoglycémies et hyperglycémies sévères."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I valori predefiniti seguono il consenso internazionale: un intervallo target di 70–180 mg/dL, con 54 e 250 a segnare i valori bassi e alti gravi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De standaardwaarden volgen de internationale consensus: een streefbereik van 70–180 mg/dL, met 54 en 250 als grens voor ernstig laag en hoog."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartości domyślne są zgodne z międzynarodowym konsensusem: zakres docelowy 70–180 mg/dL, a 54 i 250 wyznaczają ciężkie niedocukrzenia i przecukrzenia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As predefinições seguem o consenso internacional: um alvo de 70–180 mg/dL, com 54 e 250 a marcar mínimas e máximas graves."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Valorile implicite urmează consensul internațional: o țintă de 70–180 mg/dL, cu 54 și 250 marcând valorile scăzute și crescute severe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значения по умолчанию следуют международному консенсусу: целевой диапазон 70–180 mg/dL, а 54 и 250 отмечают тяжёлые гипо- и гипергликемии."
          }
        }
      }
    },
