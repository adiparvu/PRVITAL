    "Test roughly every 2–4 hours, including overnight, because illness can move your numbers quickly.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Miss etwa alle 2–4 Stunden, auch nachts, denn Krankheit kann deine Werte schnell verändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mide aproximadamente cada 2–4 horas, incluida la noche, porque la enfermedad puede mover tus valores con rapidez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Testez environ toutes les 2 à 4 heures, y compris la nuit, car la maladie peut faire évoluer vos valeurs rapidement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Misura all'incirca ogni 2–4 ore, anche di notte, perché la malattia può far cambiare i valori rapidamente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Test ongeveer elke 2–4 uur, ook 's nachts, want ziekte kan je waarden snel veranderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Badaj się mniej więcej co 2–4 godziny, także w nocy, bo choroba może szybko zmieniać wyniki."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Testa aproximadamente a cada 2–4 horas, incluindo durante a noite, porque a doença pode alterar os teus valores rapidamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Testează aproximativ la fiecare 2–4 ore, inclusiv noaptea, pentru că boala îți poate schimba valorile rapid."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Измеряйте примерно каждые 2–4 часа, в том числе ночью, — во время болезни показатели могут меняться быстро."
          }
        }
      }
    },
    "Testing…": {
      "extractionState": "manual",
      "localizations": {
