    "After a longer night, your mornings tend to start higher." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach einer längeren Nacht starten deine Morgen meist höher."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras una noche más larga, tus mañanas suelen empezar más altas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après une nuit plus longue, tes matins démarrent souvent plus haut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo una notte più lunga, le tue mattine partono più alte."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na een langere nacht beginnen je ochtenden meestal hoger."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po dłuższej nocy poranki zaczynają się zwykle wyżej."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois de uma noite mais longa, as manhãs começam mais altas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "După o noapte mai lungă, diminețile tale pornesc de obicei mai sus."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После более долгой ночи утро обычно начинается выше."
          }
        }
      }
    },
    "After a longer night, your mornings tend to start lower." : {
      "extractionState" : "manual",
