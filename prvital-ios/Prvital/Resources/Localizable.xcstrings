    "Free-text labels for your own records and shared reports — handy at appointments. Prvital never recommends insulin or doses." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freitext-Bezeichnungen für deine eigenen Aufzeichnungen und geteilten Berichte – praktisch bei Terminen. Prvital empfiehlt niemals Insulin oder Dosen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etiquetas de texto libre para tus propios registros e informes compartidos: útiles en las citas. Prvital nunca recomienda insulina ni dosis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Étiquettes de texte libre pour vos propres archives et rapports partagés — pratiques lors des rendez-vous. Prvital ne recommande jamais d'insuline ni de doses."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etichette di testo libero per i tuoi appunti e i referti condivisi — comode agli appuntamenti. Prvital non consiglia mai insulina o dosi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vrijetekstlabels voor je eigen dossier en gedeelde rapporten — handig bij afspraken. Prvital beveelt nooit insuline of doses aan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etykiety tekstowe do Twoich własnych zapisów i udostępnianych raportów — przydatne na wizytach. Prvital nigdy nie zaleca insuliny ani dawek."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etiquetas de texto livre para os teus registos e relatórios partilhados — úteis nas consultas. O Prvital nunca recomenda insulina nem doses."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etichete de text liber pentru evidența ta și rapoartele partajate — utile la programări. Prvital nu recomandă niciodată insulină sau doze."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Произвольные текстовые метки для ваших записей и общих отчётов — удобно на приёме. Prvital никогда не рекомендует инсулин или дозы."
          }
        }
      }
    },
