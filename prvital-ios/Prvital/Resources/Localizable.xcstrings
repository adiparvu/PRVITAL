    "Log glucose, insulin, meals, activity and notes — they'll appear here on your timeline.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Glukose, Insulin, Mahlzeiten, Aktivität und Notizen erfassen — sie erscheinen hier in der Zeitleiste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota glucosa, insulina, comidas, actividad y notas — aparecerán aquí en tu cronología."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez glycémie, insuline, repas, activité et notes — ils apparaîtront ici sur votre chronologie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra glicemia, insulina, pasti, attività e note — appariranno qui sulla tua cronologia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noteer glucose, insuline, maaltijden, activiteit en notities — ze verschijnen hier op je tijdlijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisuj glukozę, insulinę, posiłki, aktywność i notatki — pojawią się tutaj na Twojej osi czasu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Regista glicose, insulina, refeições, atividade e notas — vão aparecer aqui na tua cronologia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrează glicemie, insulină, mese, activitate și notițe — vor apărea aici pe cronologia ta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записывайте глюкозу, инсулин, приёмы пищи, активность и заметки — они появятся здесь на вашей ленте времени."
          }
        }
      }
    },
