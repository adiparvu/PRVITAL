    "Do NOT give me food or drink. Use my glucagon if you can find it, and call emergency services (112 / 911).": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie mir NICHTS zu essen oder zu trinken. Verwenden Sie mein Glukagon, wenn Sie es finden, und rufen Sie den Notruf (112 / 911)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "NO me des comida ni bebida. Usa mi glucagón si puedes encontrarlo y llama a emergencias (112 / 911)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne me donnez NI nourriture NI boisson. Utilisez mon glucagon si vous le trouvez et appelez les secours (112 / 911)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "NON datemi cibo né bevande. Usate il mio glucagone se riuscite a trovarlo e chiamate i soccorsi (112 / 911)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef me GEEN eten of drinken. Gebruik mijn glucagon als je die kunt vinden en bel de hulpdiensten (112 / 911)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "NIE podawaj mi jedzenia ani picia. Użyj mojego glukagonu, jeśli go znajdziesz, i zadzwoń po pogotowie (112 / 911)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "NÃO me dê comida nem bebida. Use o meu glucagon se o encontrar e ligue para a emergência (112 / 911)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "NU îmi da mâncare sau băutură. Folosește glucagonul meu dacă îl găsești și sună la urgențe (112 / 911)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "НЕ давайте мне еду или питьё. Используйте мой глюкагон, если найдёте его, и вызовите скорую помощь (112 / 911)."
          }
        }
      }
    },
