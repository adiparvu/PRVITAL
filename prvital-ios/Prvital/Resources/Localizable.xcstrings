    "Drag to reorder. The glucose ring, quick actions and safety banners always stay at the top." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Umordnen ziehen. Glukosering, Schnellaktionen und Sicherheitsbanner bleiben immer oben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra para reordenar. El anillo de glucosa, las acciones rápidas y los avisos de seguridad siempre quedan arriba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser pour réorganiser. L'anneau de glycémie, les actions rapides et les bannières de sécurité restent toujours en haut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina per riordinare. L'anello della glicemia, le azioni rapide e i banner di sicurezza restano sempre in alto."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep om te herschikken. De glucosering, snelle acties en veiligheidsbanners blijven altijd bovenaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeciągnij, aby zmienić kolejność. Pierścień glikemii, szybkie akcje i banery bezpieczeństwa zawsze zostają u góry."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste para reordenar. O anel de glicemia, as ações rápidas e os avisos de segurança ficam sempre no topo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trage pentru a rearanja. Inelul glicemiei, acțiunile rapide și bannerele de siguranță rămân mereu sus."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетащите, чтобы изменить порядок. Кольцо глюкозы, быстрые действия и баннеры безопасности всегда остаются сверху."
          }
        }
      }
    },
    "Dress with olive oil, lemon and oregano, and toss." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Olivenöl, Zitrone und Oregano anmachen und vermengen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aliña con aceite de oliva, limón y orégano, y mezcla bien."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assaisonne avec l'huile d'olive, le citron et l'origan, puis mélange."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Condisci con olio d'oliva, limone e origano, e mescola."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Besprenkel met olijfolie, citroen en oregano, en schep om."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrop oliwą, sokiem z cytryny i oregano, i wymieszaj."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempera com azeite, limão e orégãos, e envolve bem."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asezonează cu ulei de măsline, lămâie și oregano, apoi amestecă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заправь оливковым маслом, лимоном и орегано, перемешай."
          }
        }
      }
    },
