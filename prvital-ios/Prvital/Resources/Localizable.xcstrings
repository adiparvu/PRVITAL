    "On most mornings your glucose climbs from its overnight low into breakfast — the dawn phenomenon. Seen on %lld days.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An den meisten Morgen steigt die Glukose vom nächtlichen Tief bis zum Frühstück — das Dawn-Phänomen. An %lld Tagen beobachtet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mayoría de las mañanas tu glucosa sube desde su mínimo nocturno hasta el desayuno — el fenómeno del alba. Observado en %lld días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La plupart des matins, votre glycémie monte de son minimum nocturne jusqu'au petit-déjeuner — le phénomène de l'aube. Observé sur %lld jours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nella maggior parte delle mattine la glicemia sale dal minimo notturno fino alla colazione — il fenomeno dell'alba. Osservato in %lld giorni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op de meeste ochtenden stijgt je glucose vanaf het nachtelijke dieptepunt richting het ontbijt — het dawn-fenomeen. Gezien op %lld dagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W większość poranków Twoja glukoza rośnie z nocnego minimum do śniadania — to zjawisko brzasku. Zaobserwowano w %lld dniach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Na maioria das manhãs, a tua glicose sobe do mínimo noturno até ao pequeno-almoço — o fenómeno do amanhecer. Observado em %lld dias."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În majoritatea dimineților glicemia urcă de la minimul nocturn spre micul dejun — fenomenul de zori. Observat în %lld zile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В большинство утр ваша глюкоза поднимается от ночного минимума к завтраку — феномен утренней зари. Замечено за %lld дн."
          }
        }
      }
    },
