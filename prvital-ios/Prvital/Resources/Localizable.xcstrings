    "Keep taking insulin, check more often, watch for ketones, stay hydrated.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Insulin weiter nehmen, öfter messen, auf Ketone achten, genug trinken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue con la insulina, mide más a menudo, vigila las cetonas y mantente hidratado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuez l'insuline, contrôlez plus souvent, surveillez les cétones, restez hydraté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua l'insulina, controlla più spesso, tieni d'occhio i chetoni, mantieniti idratato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blijf insuline nemen, meet vaker, let op ketonen, blijf gehydrateerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie przerywaj insuliny, badaj się częściej, uważaj na ketony, dbaj o nawodnienie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua a insulina, verifica com mais frequência, atenção às cetonas, mantém-te hidratado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuă insulina, verifică mai des, fii atent la cetone, rămâi hidratat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжайте инсулин, проверяйте чаще, следите за кетонами, пейте достаточно."
          }
        }
      }
    },
    "Keep taking your insulin": {
      "extractionState": "manual",
      "localizations": {
