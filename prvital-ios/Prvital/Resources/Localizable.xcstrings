    "Only used to personalise the app and label what you share. It stays on your device (and your own iCloud, if enabled).": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird nur verwendet, um die App zu personalisieren und geteilte Inhalte zu benennen. Verbleibt auf dem Gerät (und in Ihrer eigenen iCloud, sofern aktiviert)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se usa para personalizar la app y etiquetar lo que compartes. Permanece en tu dispositivo (y en tu propio iCloud, si está activado)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé uniquement pour personnaliser l'application et identifier ce que vous partagez. Reste sur votre appareil (et votre propre iCloud, si activé)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usato solo per personalizzare l'app ed etichettare ciò che condividi. Rimane sul tuo dispositivo (e sul tuo iCloud, se attivo)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt alleen gebruikt om de app te personaliseren en te labelen wat je deelt. Het blijft op je apparaat (en je eigen iCloud, indien ingeschakeld)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używane wyłącznie do personalizacji aplikacji i podpisywania udostępnianych treści. Pozostaje na Twoim urządzeniu (oraz w Twoim iCloud, jeśli jest włączony)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizado apenas para personalizar a aplicação e identificar o que partilha. Permanece no seu dispositivo (e no seu próprio iCloud, se ativado)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se folosește doar pentru a personaliza aplicația și a eticheta ce distribui. Rămâne pe dispozitivul tău (și în propriul iCloud, dacă este activat)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется только для персонализации приложения и подписи того, чем вы делитесь. Данные остаются на вашем устройстве (и в вашем iCloud, если включён)."
          }
        }
      }
    },
