    "Feedback goes to %@. Prefer Messages or another app? Use Share." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Feedback geht an %@. Lieber Nachrichten oder eine andere App nutzen? Verwende Teilen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los comentarios se envían a %@. ¿Prefieres Mensajes u otra app? Usa Compartir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les commentaires sont envoyés à %@. Tu préfères Messages ou une autre appli ? Utilise Partager."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il feedback verrà inviato a %@. Preferisci Messaggi o un'altra app? Usa Condividi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
