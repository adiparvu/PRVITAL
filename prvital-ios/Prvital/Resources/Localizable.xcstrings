    "Get notified about your glucose while the app can sync a recent reading. Alerts are delivered as local notifications on this device.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalte Benachrichtigungen zu deiner Glukose, solange die App einen aktuellen Wert synchronisieren kann. Warnungen werden als lokale Mitteilungen auf diesem Gerät zugestellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibe avisos sobre tu glucosa mientras la app pueda sincronizar una lectura reciente. Las alertas se entregan como notificaciones locales en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soyez averti de votre glycémie tant que l'app peut synchroniser une mesure récente. Les alertes sont envoyées sous forme de notifications locales sur cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricevi notifiche sulla tua glicemia finché l'app può sincronizzare una lettura recente. Gli avvisi vengono recapitati come notifiche locali su questo dispositivo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontvang meldingen over je glucose zolang de app een recente meting kan synchroniseren. Waarschuwingen worden als lokale meldingen op dit apparaat bezorgd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otrzymuj powiadomienia o glukozie, dopóki aplikacja może zsynchronizować niedawny odczyt. Alerty są dostarczane jako powiadomienia lokalne na tym urządzeniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Recebe avisos sobre a tua glicose enquanto a app conseguir sincronizar uma leitura recente. Os alertas são entregues como notificações locais neste dispositivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Primește notificări despre glicemie cât timp aplicația poate sincroniza o citire recentă. Alertele sunt livrate ca notificări locale pe acest dispozitiv."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получайте уведомления о глюкозе, пока приложение может синхронизировать недавнее измерение. Оповещения доставляются как локальные уведомления на этом устройстве."
          }
        }
      }
    },
