            "state" : "translated",
            "value" : "Tocca un suono per ascoltarlo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op een geluid om het te horen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij dźwięk, aby go odsłuchać."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque num som para o ouvir."
          }
