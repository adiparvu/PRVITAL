    "Text size and background apply to Prvital only. Haptics add a gentle tap to key actions.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text size and background apply to Prvital only. Haptics add a gentle tap to key actions."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mărimea textului și fundalul se aplică doar în Prvital. Feedbackul haptic adaugă o vibrație ușoară la acțiunile cheie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Textgröße und Hintergrund gelten nur für Prvital. Haptik fügt wichtigen Aktionen ein sanftes Tippen hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tamaño del texto y el fondo se aplican solo a Prvital. La respuesta háptica añade un toque suave a las acciones clave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La taille du texte et l'arrière-plan s'appliquent uniquement à Prvital. Le retour haptique ajoute une légère vibration aux actions clés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimensione del testo e sfondo si applicano solo a Prvital. Il feedback aptico aggiunge un lieve tocco alle azioni principali."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekstgrootte en achtergrond gelden alleen voor Prvital. Haptiek voegt een zachte tik toe aan belangrijke acties."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozmiar tekstu i tło dotyczą tylko Prvital. Reakcje dotykowe dodają delikatne stuknięcie przy kluczowych czynnościach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O tamanho do texto e o fundo aplicam-se apenas ao Prvital. O feedback tátil adiciona um toque suave às ações principais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размер текста и фон применяются только в Prvital. Тактильный отклик добавляет лёгкое касание при ключевых действиях."
          }
        }
      }
    },
