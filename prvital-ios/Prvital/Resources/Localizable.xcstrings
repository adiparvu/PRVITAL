    "Generated from your own readings — general guidance, not medical advice. Talk to your care team before changing doses.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellt aus deinen eigenen Messwerten — allgemeine Orientierung, keine medizinische Beratung. Sprich mit deinem Behandlungsteam, bevor du Dosen änderst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Generado a partir de tus propias lecturas — es una orientación general, no un consejo médico. Habla con tu equipo médico antes de cambiar las dosis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Généré à partir de tes propres relevés — un repère général, pas un avis médical. Parle à ton équipe soignante avant de changer tes doses."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Generato dalle tue rilevazioni — un'indicazione generale, non un consiglio medico. Parla con il tuo team curante prima di modificare le dosi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gegenereerd op basis van je eigen metingen — algemene richtlijnen, geen medisch advies. Overleg met je behandelteam voordat je doseringen aanpast."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wygenerowane na podstawie Twoich własnych odczytów — to ogólna wskazówka, a nie porada medyczna. Przed zmianą dawek porozmawiaj ze swoim zespołem opieki."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerado a partir das tuas próprias leituras — orientação geral, não é aconselhamento médico. Fala com a tua equipa antes de alterar doses."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Generat pe baza propriilor tale citiri — un ghid general, nu un sfat medical. Discută cu echipa ta medicală înainte de a modifica dozele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Составлено на основе твоих собственных показаний — это общие рекомендации, а не медицинское назначение. Прежде чем менять дозы, посоветуйся со своей лечащей командой."
          }
        }
      }
    },
