    "Glucose drops about %lld mg/dL after activity — watch for lows": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Glukose fällt nach Aktivität um etwa %lld mg/dL – auf Unterzuckerungen achten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La glucosa baja unos %lld mg/dL después de la actividad: atento a las hipoglucemias"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La glycémie baisse d'environ %lld mg/dL après l'activité — attention aux hypos"
          }
        },
        "it": {
          "stringUnit": {
