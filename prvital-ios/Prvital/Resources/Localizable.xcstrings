    "This device has no Mail account set up. Use “Share another way” to send your feedback with another app." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem Gerät ist kein Mail-Account eingerichtet. Verwende “Anders teilen”, um dein Feedback mit einer anderen App zu senden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo no tiene ninguna cuenta de correo configurada. Usa “Compartir de otra forma” para enviar tus comentarios con otra app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun compte Mail n'est configuré sur cet appareil. Utilisez “Partager autrement” pour envoyer votre commentaire avec une autre app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su questo dispositivo non è configurato alcun account Mail. Usa “Condividi in altro modo” per inviare il tuo feedback con un'altra app."
