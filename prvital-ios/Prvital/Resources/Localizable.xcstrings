    "Recheck before correcting again; rapid insulin can keep working for 3–5 hours." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miss erneut, bevor du wieder korrigierst; schnell wirkendes Insulin kann noch 3–5 Stunden lang wirken."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a comprobar antes de corregir de nuevo; la insulina rápida puede seguir actuando durante 3–5 horas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recontrôle avant de corriger à nouveau ; l'insuline rapide peut continuer à agir pendant 3 à 5 heures."
