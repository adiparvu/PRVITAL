            "state": "translated",
            "value": "Panou"
          }
        }
      }
    },
    "Defaults follow the international consensus: a 70–180 mg/dL target with 54 and 250 marking severe lows and highs.": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Valorile implicite urmează consensul internațional: o țintă de 70–180 mg/dL, cu 54 și 250 marcând valorile scăzute și crescute severe."
          }
        }
      }
    },
    "Delete": {
