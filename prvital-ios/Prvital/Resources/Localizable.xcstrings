    "You logged %lld g of carbs but no bolus. Add your dose if you meant to.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast %lld g Kohlenhydrate erfasst, aber keinen Bolus. Füge die Dosis hinzu, falls beabsichtigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registraste %lld g de carbohidratos pero ningún bolo. Añade tu dosis si era tu intención."
          }
        },
        "fr": {
          "stringUnit": {
