            "state": "translated",
            "value": "Un registro de cada acción sensible"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un journal de chaque action sensible"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un registro di ogni azione sensibile"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een logboek van elke gevoelige actie"
          }
