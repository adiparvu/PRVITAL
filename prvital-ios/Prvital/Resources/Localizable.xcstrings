    "Aim for a different — often tighter — range while you sleep. It applies to the chart's target band and your Time-in-Range during those hours.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziele im Schlaf einen anderen — oft engeren — Bereich an. Er gilt für das Zielband im Diagramm und deine Zeit im Zielbereich während dieser Stunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apunta a un rango diferente —a menudo más estrecho— mientras duermes. Se aplica a la banda objetivo del gráfico y a tu tiempo en rango durante esas horas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Visez une plage différente — souvent plus étroite — pendant votre sommeil. Elle s'applique à la bande cible du graphique et à votre temps dans la cible durant ces heures."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Punta a un intervallo diverso — spesso più stretto — mentre dormi. Si applica alla banda obiettivo del grafico e al tuo tempo nell'intervallo durante quelle ore."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Streef tijdens je slaap naar een ander — vaak strakker — bereik. Het geldt voor de doelband in de grafiek en je tijd binnen bereik gedurende die uren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W trakcie snu dąż do innego — często węższego — zakresu. Dotyczy on docelowego pasma na wykresie oraz Twojego czasu w zakresie w tych godzinach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Procura um intervalo diferente — muitas vezes mais apertado — enquanto dormes. Aplica-se à banda-alvo do gráfico e ao teu tempo dentro do intervalo durante essas horas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Urmărește un interval diferit — adesea mai strâns — în timpul somnului. Se aplică benzii-țintă din grafic și timpului tău în interval în acele ore."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стремитесь к другому — часто более узкому — диапазону во время сна. Он применяется к целевой зоне на графике и вашему времени в диапазоне в эти часы."
          }
        }
      }
    },
    "All three rings closed today": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle drei Ringe heute geschlossen"
          }
