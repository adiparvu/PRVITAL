          }
        }
      }
    },
    "Add records from a CSV file exported from Prvital, Dexcom Clarity or LibreView. The format is detected automatically, imported rows are added as manual entries, and duplicate glucose readings are resolved automatically.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Einträge aus einer CSV-Datei hinzu, die aus Prvital, Dexcom Clarity oder LibreView exportiert wurde. Das Format wird automatisch erkannt, importierte Zeilen werden als manuelle Einträge hinzugefügt und doppelte Glukosemesswerte werden automatisch bereinigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade registros desde un archivo CSV exportado de Prvital, Dexcom Clarity o LibreView. El formato se detecta automáticamente, las filas importadas se añaden como entradas manuales y las lecturas de glucosa duplicadas se resuelven automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des enregistrements à partir d'un fichier CSV exporté depuis Prvital, Dexcom Clarity ou LibreView. Le format est détecté automatiquement, les lignes importées sont ajoutées comme saisies manuelles et les mesures de glycémie en double sont résolues automatiquement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi record da un file CSV esportato da Prvital, Dexcom Clarity o LibreView. Il formato viene rilevato automaticamente, le righe importate vengono aggiunte come voci manuali e le letture della glicemia duplicate vengono risolte automaticamente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg records toe uit een CSV-bestand dat is geëxporteerd uit Prvital, Dexcom Clarity of LibreView. Het formaat wordt automatisch herkend, geïmporteerde rijen worden als handmatige invoer toegevoegd en dubbele glucosemetingen worden automatisch opgelost."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj rekordy z pliku CSV wyeksportowanego z Prvital, Dexcom Clarity lub LibreView. Format jest wykrywany automatycznie, zaimportowane wiersze są dodawane jako wpisy ręczne, a zduplikowane odczyty glukozy są rozwiązywane automatycznie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona registos a partir de um ficheiro CSV exportado da Prvital, do Dexcom Clarity ou do LibreView. O formato é detetado automaticamente, as linhas importadas são adicionadas como entradas manuais e as leituras de glicose duplicadas são resolvidas automaticamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă înregistrări dintr-un fișier CSV exportat din Prvital, Dexcom Clarity sau LibreView. Formatul este detectat automat, rândurile importate sunt adăugate ca intrări manuale, iar citirile de glicemie duplicate sunt rezolvate automat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте записи из CSV-файла, экспортированного из Prvital, Dexcom Clarity или LibreView. Формат определяется автоматически, импортированные строки добавляются как ручные записи, а дублирующиеся измерения глюкозы устраняются автоматически."
          }
        }
      }
    },
    "Add records from a CSV file you exported from Prvital. Imported rows are added as manual entries, and duplicate glucose readings are resolved automatically.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Einträge aus einer CSV-Datei hinzu, die du aus Prvital exportiert hast. Importierte Zeilen werden als manuelle Einträge hinzugefügt und doppelte Glukosemesswerte werden automatisch bereinigt."
