    "Private by design, private by default": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Confidențial prin concepție, confidențial implicit"
          }
        }
      }
    },
    "Prvital is private by design. Your health data lives on this device (and, only if you turn it on, your own private iCloud). It is never sold, never used for advertising, and never used to train models without your consent.": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Prvital este confidențial prin concepție. Datele tale medicale rămân pe acest dispozitiv (și, doar dacă activezi, în propriul tău iCloud privat). Nu sunt niciodată vândute, folosite pentru publicitate sau pentru antrenarea de modele fără consimțământul tău."
          }
        }
      }
    },
