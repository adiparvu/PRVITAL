    "Optional. Helps put your long-term trends in context." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional. Hilft, langfristige Trends einzuordnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional. Ayuda a contextualizar tus tendencias a largo plazo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facultatif. Aide à mettre en contexte vos tendances à long terme."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facoltativo. Aiuta a contestualizzare le tue tendenze a lungo termine."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optioneel. Helpt om je langetermijntrends in context te plaatsen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
