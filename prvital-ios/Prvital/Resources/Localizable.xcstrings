    "Urgent lows and highs, the escalation repeats, the predicted-low warning and falling-fast alerts." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dringende Unter- und Überzuckerungen, die Eskalations-Wiederholungen, die Warnung vor einem vorhergesagten Tief und die Schnell-fallend-Warnungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bajadas y subidas urgentes, las repeticiones de la escalada, el aviso de hipoglucemia prevista y las alertas de caída rápida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hypos et hypers urgentes, les répétitions d’escalade, l’alerte d’hypo prédite et les alertes de chute rapide."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ipo e iper urgenti, le ripetizioni dell’escalation, l’avviso di ipoglicemia prevista e gli avvisi di calo rapido."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urgente lage en hoge waarden, de escalatieherhalingen, de waarschuwing voor een voorspelde lage waarde en de snel-dalend-meldingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilne niedocukrzenia i przecukrzenia, powtórzenia eskalacji, ostrzeżenie o przewidywanym spadku i alerty szybkiego spadku."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baixas e altas urgentes, as repetições da escalada, o aviso de hipoglicemia prevista e os alertas de queda rápida."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
