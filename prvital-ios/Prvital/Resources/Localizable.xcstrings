    "Connect Dexcom (via Dexcom Share) or FreeStyle Libre (via LibreLinkUp) with your account. Credentials are kept in this device's Keychain." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinde Dexcom (über Dexcom Share) oder FreeStyle Libre (über LibreLinkUp) mit deinem Konto. Die Zugangsdaten werden im Schlüsselbund dieses Geräts gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta Dexcom (a través de Dexcom Share) o FreeStyle Libre (a través de LibreLinkUp) con tu cuenta. Las credenciales se guardan en el Llavero de este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez Dexcom (via Dexcom Share) ou FreeStyle Libre (via LibreLinkUp) à votre compte. Les identifiants sont conservés dans le trousseau de cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connetti Dexcom (tramite Dexcom Share) o FreeStyle Libre (tramite LibreLinkUp) al tuo account. Le credenziali vengono conservate nel portachiavi di questo dispositivo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbind Dexcom (via Dexcom Share) of FreeStyle Libre (via LibreLinkUp) met je account. De inloggegevens worden bewaard in de sleutelhanger van dit apparaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Połącz Dexcom (przez Dexcom Share) lub FreeStyle Libre (przez LibreLinkUp) ze swoim kontem. Dane logowania są przechowywane w pęku kluczy tego urządzenia."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liga o Dexcom (através do Dexcom Share) ou o FreeStyle Libre (através do LibreLinkUp) à tua conta. As credenciais são guardadas no porta-chaves deste dispositivo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conectează Dexcom (prin Dexcom Share) sau FreeStyle Libre (prin LibreLinkUp) la contul tău. Datele de autentificare sunt păstrate în brelocul acestui dispozitiv."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключите Dexcom (через Dexcom Share) или FreeStyle Libre (через LibreLinkUp) к своему аккаунту. Учётные данные хранятся в связке ключей этого устройства."
          }
        }
      }
    },
    "Connect a Dexcom or FreeStyle Libre sensor so readings arrive automatically. You choose which sensor is your primary source." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinde einen Dexcom- oder FreeStyle Libre-Sensor, damit die Messwerte automatisch ankommen. Du entscheidest, welcher Sensor deine primäre Quelle ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta un sensor Dexcom o FreeStyle Libre para que las lecturas lleguen automáticamente. Tú eliges qué sensor es tu fuente principal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez un capteur Dexcom ou FreeStyle Libre pour recevoir les mesures automatiquement. Vous choisissez le capteur qui sera votre source principale."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collega un sensore Dexcom o FreeStyle Libre per ricevere le letture automaticamente. Scegli tu quale sensore è la tua fonte principale."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbind een Dexcom- of FreeStyle Libre-sensor zodat metingen automatisch binnenkomen. Jij kiest welke sensor je primaire bron is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Połącz sensor Dexcom lub FreeStyle Libre, aby odczyty pojawiały się automatycznie. To Ty wybierasz, który sensor jest Twoim głównym źródłem."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liga um sensor Dexcom ou FreeStyle Libre para que as leituras cheguem automaticamente. És tu que escolhes qual o sensor que é a tua fonte principal."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conectează un senzor Dexcom sau FreeStyle Libre pentru ca valorile să sosească automat. Tu alegi care senzor este sursa ta principală."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключите датчик Dexcom или FreeStyle Libre, чтобы показания поступали автоматически. Вы сами выбираете, какой датчик станет основным источником."
          }
        }
      }
    },
