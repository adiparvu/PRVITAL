    "Keep your trend complete with a quick reading.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Trend mit einem schnellen Messwert vollständig halten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén tu tendencia completa con una lectura rápida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez votre tendance complète avec une mesure rapide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni completo il tuo andamento con una lettura rapida."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd je trend compleet met een snelle meting."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utrzymaj kompletny trend dzięki szybkiemu odczytowi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém a tua tendência completa com uma leitura rápida."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Păstrează-ți tendința completă cu o citire rapidă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраните полноту тренда быстрым измерением."
          }
        }
      }
    },
    "Keeps this meal one tap away next time you log carbs.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält diese Mahlzeit beim nächsten Kohlenhydrat-Eintrag nur einen Tipp entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja esta comida a un toque la próxima vez que registres carbohidratos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde ce repas à portée d'un geste la prochaine fois que vous enregistrez des glucides."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiene questo pasto a un tocco di distanza la prossima volta che registri i carboidrati."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houdt deze maaltijd één tik verwijderd wanneer je de volgende keer koolhydraten vastlegt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten posiłek będzie o jedno dotknięcie, gdy następnym razem zapiszesz węglowodany."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém esta refeição a um toque de distância da próxima vez que registares hidratos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Păstrează această masă la o atingere distanță data viitoare când înregistrezi carbohidrați."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это блюдо будет доступно в одно касание при следующей записи углеводов."
          }
        }
      }
    },
    "Kept on this device, shown only on this card.": {
      "extractionState": "manual",
      "localizations": {
