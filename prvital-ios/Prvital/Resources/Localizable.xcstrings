    "Soften the mushrooms and pepper in a little oil." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Champignons und Paprika in etwas Öl andünsten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rehoga los champiñones y el pimiento en un poco de aceite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fais revenir les champignons et le poivron dans un peu d'huile."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai appassire i funghi e il peperone in un filo d'olio."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fruit de champignons en paprika kort in een beetje olie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podsmaż pieczarki i paprykę na odrobinie oliwy, aż zmiękną."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Refoga os cogumelos e o pimento num pouco de azeite."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Călește ciupercile și ardeiul într-un pic de ulei, până se înmoaie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обжарь грибы и перец в небольшом количестве масла до мягкости."
          }
        }
      }
    },
    "Soften the onion, carrot and celery in olive oil with the garlic and cumin." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwiebel, Karotte und Sellerie mit Knoblauch und Kreuzkümmel in Olivenöl andünsten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rehoga la cebolla, la zanahoria y el apio en aceite de oliva con el ajo y el comino."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fais revenir l'oignon, la carotte et le céleri dans l'huile d'olive avec l'ail et le cumin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai appassire cipolla, carota e sedano nell'olio d'oliva con aglio e cumino."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fruit de ui, wortel en bleekselderij in olijfolie met de knoflook en komijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podsmaż cebulę, marchewkę i seler na oliwie z czosnkiem i kminem rzymskim, aż zmiękną."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Refoga a cebola, a cenoura e o aipo em azeite com o alho e os cominhos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Călește ceapa, morcovul și țelina în ulei de măsline, împreună cu usturoiul și chimionul, până se înmoaie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обжарь лук, морковь и сельдерей на оливковом масле с чесноком и зирой до мягкости."
          }
        }
      }
    },
    "Someone who knows about your diabetes — a partner, parent or friend. Their number becomes a tappable call button on the card. Swipe a contact to remove it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jemand, der über deinen Diabetes Bescheid weiß — Partner, Elternteil oder Freund. Die Nummer wird auf der Karte zu einem antippbaren Anruf-Button. Streiche über einen Kontakt, um ihn zu entfernen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguien que conozca tu diabetes: tu pareja, un familiar o una amistad. Su número se convierte en un botón de llamada en la tarjeta. Desliza un contacto para eliminarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelqu'un qui connaît votre diabète — partenaire, parent ou ami. Son numéro devient un bouton d'appel sur la carte. Balayez un contact pour le supprimer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualcuno che conosce il tuo diabete: partner, genitore o amico. Il suo numero diventa un pulsante di chiamata sulla scheda. Scorri su un contatto per rimuoverlo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iemand die van je diabetes weet — partner, ouder of vriend. Het nummer wordt een aantikbare belknop op de kaart. Veeg over een contact om het te verwijderen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ktoś, kto wie o Twojej cukrzycy — partner, rodzic lub przyjaciel. Numer stanie się przyciskiem połączenia na karcie. Przesuń kontakt, aby go usunąć."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguém que saiba da tua diabetes — companheiro, familiar ou amigo. O número torna-se um botão de chamada no cartão. Desliza um contacto para o remover."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cineva care știe despre diabetul tău — partener, părinte sau prieten. Numărul devine un buton de apel pe card. Glisează un contact pentru a-l elimina."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тот, кто знает о вашем диабете, — партнёр, родитель или друг. Номер станет кнопкой вызова на карточке. Смахните контакт, чтобы удалить его."
          }
        }
      }
    },
    "Sound" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton"
          }
        },
        "es" : {
          "stringUnit" : {
