    "Raised — this carries a risk of DKA. Contact your care team and follow your ketone plan now.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhöht — das birgt ein DKA-Risiko. Kontaktiere jetzt dein Behandlungsteam und befolge deinen Ketonplan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elevadas — esto conlleva riesgo de DKA. Contacta con tu equipo médico y sigue tu plan de cetonas ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Élevé — cela comporte un risque de DKA. Contacte ton équipe soignante et suis ton plan cétones dès maintenant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elevati — comporta un rischio di DKA. Contatta subito il tuo team curante e segui il tuo piano per i chetoni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verhoogd — dit brengt een risico op DKA met zich mee. Neem nu contact op met je behandelteam en volg je ketonplan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podwyższony — to niesie ryzyko DKA. Skontaktuj się teraz ze swoim zespołem opieki i postępuj zgodnie ze swoim planem na wypadek ketonów."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Elevado — isto acarreta um risco de DKA. Contacta a tua equipa e segue já o teu plano para cetonas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Crescute — acest lucru prezintă risc de DKA. Contactează-ți echipa medicală și urmează-ți planul pentru cetone acum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повышены — это несёт риск DKA. Свяжись со своей лечащей командой и сейчас же следуй своему плану на случай кетонов."
          }
        }
      }
    },
