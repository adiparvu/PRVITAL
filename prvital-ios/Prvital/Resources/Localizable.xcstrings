          }
        }
      }
    },
    "The same level won't alert again within this window. A change in level — for example low to urgent low, or crossing back through your range — always alerts right away.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieselbe Stufe löst innerhalb dieses Fensters keine erneute Warnung aus. Ein Stufenwechsel — z. B. von niedrig zu dringend niedrig oder zurück durch deinen Zielbereich — warnt immer sofort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mismo nivel no vuelve a avisar dentro de esta ventana. Un cambio de nivel —por ejemplo de bajo a bajo urgente, o al volver a cruzar tu rango— siempre avisa de inmediato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le même niveau ne redéclenche pas d'alerte pendant cette fenêtre. Un changement de niveau — par exemple de bas à bas urgent, ou en retraversant votre plage — alerte toujours immédiatement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo stesso livello non genera un nuovo avviso entro questa finestra. Un cambio di livello — per esempio da basso a basso urgente, o riattraversando il tuo intervallo — avvisa sempre subito."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hetzelfde niveau waarschuwt niet opnieuw binnen dit venster. Een niveauverandering — bijvoorbeeld van laag naar urgent laag, of terug door je bereik — waarschuwt altijd direct."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten sam poziom nie wywoła ponownego alertu w tym oknie. Zmiana poziomu — np. z niskiego na pilnie niski albo ponowne przekroczenie Twojego zakresu — zawsze alarmuje od razu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O mesmo nível não volta a alertar dentro desta janela. Uma mudança de nível — por exemplo de baixo para urgentemente baixo, ou ao voltar a atravessar o teu intervalo — alerta sempre de imediato."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Același nivel nu mai alertează în această fereastră. O schimbare de nivel — de exemplu de la scăzut la urgent scăzut, sau retraversarea intervalului tău — alertează întotdeauna imediat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тот же уровень не вызовет повторного оповещения в течение этого окна. Смена уровня — например, с низкого на критически низкий или обратный переход через ваш диапазон — всегда оповещает сразу."
          }
        }
      }
    },
    "The sick-day rules": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Krankheitsregeln"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las reglas para días de enfermedad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les règles des jours de maladie"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le regole dei giorni di malattia"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De ziektedagregels"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zasady na czas choroby"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As regras dos dias de doença"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Regulile zilelor de boală"
          }
        },
        "ru": {
