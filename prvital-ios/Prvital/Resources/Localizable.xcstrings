    "Evenings run high. Lighter dinner carbs or an earlier bolus may help." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abends sind die Werte tendenziell hoch. Weniger Kohlenhydrate beim Abendessen oder ein früherer Bolus können helfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las noches tienden a subir. Menos carbohidratos en la cena o un bolo más temprano pueden ayudar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les soirées sont souvent élevées. Moins de glucides au dîner ou un bolus plus précoce peuvent aider."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sere tendono a essere alte. Carboidrati più leggeri a cena o un bolo anticipato possono aiutare."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avonden lopen hoog op. Minder koolhydraten bij het avondeten of eerder bolussen kan helpen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wieczorami poziom bywa podwyższony. Mniej węglowodanów na kolację lub wcześniejszy bolus mogą pomóc."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os finais de dia tendem a ficar altos. Reduzir os hidratos de carbono do jantar ou fazer o bólus mais cedo pode ajudar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serile tind să fie ridicate. Carbohidrați mai puțini la cină sau un bolus administrat mai devreme pot ajuta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По вечерам глюкоза обычно повышена. Может помочь меньше углеводов на ужин или более ранний болюс."
          }
        }
      }
    },
