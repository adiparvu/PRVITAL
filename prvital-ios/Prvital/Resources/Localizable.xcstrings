    "A quiet local notification when your week in review is ready. The digest itself is computed on your device when you open it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine dezente lokale Mitteilung, wenn dein Wochenrückblick bereit ist. Der Rückblick selbst wird beim Öffnen auf deinem Gerät berechnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una notificación local discreta cuando tu resumen de la semana esté listo. El resumen en sí se calcula en tu dispositivo al abrirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une notification locale discrète quand votre bilan de la semaine est prêt. Le bilan lui-même est calculé sur votre appareil quand vous l'ouvrez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una notifica locale discreta quando la tua settimana in sintesi è pronta. La sintesi viene calcolata sul tuo dispositivo quando la apri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een rustige lokale melding wanneer je weekoverzicht klaarstaat. Het overzicht zelf wordt op je apparaat berekend wanneer je het opent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dyskretne lokalne powiadomienie, gdy podsumowanie tygodnia będzie gotowe. Samo podsumowanie jest obliczane na Twoim urządzeniu przy otwarciu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma notificação local discreta quando o teu resumo da semana estiver pronto. O resumo em si é calculado no teu dispositivo quando o abres."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O notificare locală discretă când rezumatul săptămânii tale este gata. Rezumatul în sine este calculat pe dispozitivul tău când îl deschizi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тихое локальное уведомление, когда итоги недели готовы. Сами итоги вычисляются на вашем устройстве при открытии."
          }
        }
      }
    },
