    "The rules for managing diabetes through illness": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Regeln für Diabetes während einer Krankheit"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las reglas para manejar la diabetes durante una enfermedad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les règles pour gérer le diabète pendant une maladie"
          }
        },
        "it": {
          "stringUnit": {
