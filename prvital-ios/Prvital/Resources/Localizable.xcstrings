    "The phone number becomes a call button. An appointment within the next 30 days shows a countdown.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Telefonnummer wird zu einer Anruftaste. Ein Termin innerhalb der nächsten 30 Tage zeigt einen Countdown."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El número de teléfono se convierte en un botón de llamada. Una cita en los próximos 30 días muestra una cuenta atrás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le numéro de téléphone devient un bouton d'appel. Un rendez-vous dans les 30 prochains jours affiche un compte à rebours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il numero di telefono diventa un pulsante di chiamata. Un appuntamento entro i prossimi 30 giorni mostra un conto alla rovescia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het telefoonnummer wordt een belknop. Een afspraak binnen de komende 30 dagen toont een aftelteller."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Numer telefonu staje się przyciskiem połączenia. Wizyta w ciągu najbliższych 30 dni pokazuje odliczanie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O número de telefone torna-se um botão de chamada. Uma consulta nos próximos 30 dias mostra uma contagem decrescente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numărul de telefon devine un buton de apel. O programare în următoarele 30 de zile afișează o numărătoare inversă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Номер телефона становится кнопкой вызова. Приём в ближайшие 30 дней показывает обратный отсчёт."
          }
        }
      }
    },
    "The rules for managing diabetes through illness": {
      "extractionState": "manual",
