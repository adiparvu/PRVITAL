    "Someone who knows about your diabetes — a partner, parent or friend. Their number becomes a tappable call button on the card. Swipe a contact to remove it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemand, der über deinen Diabetes Bescheid weiß — Partner, Elternteil oder Freund. Die Nummer wird auf der Karte zu einem antippbaren Anruf-Button. Streiche über einen Kontakt, um ihn zu entfernen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguien que conozca tu diabetes: tu pareja, un familiar o una amistad. Su número se convierte en un botón de llamada en la tarjeta. Desliza un contacto para eliminarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelqu'un qui connaît votre diabète — partenaire, parent ou ami. Son numéro devient un bouton d'appel sur la carte. Balayez un contact pour le supprimer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcuno che conosce il tuo diabete: partner, genitore o amico. Il suo numero diventa un pulsante di chiamata sulla scheda. Scorri su un contatto per rimuoverlo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iemand die van je diabetes weet — partner, ouder of vriend. Het nummer wordt een aantikbare belknop op de kaart. Veeg over een contact om het te verwijderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ktoś, kto wie o Twojej cukrzycy — partner, rodzic lub przyjaciel. Numer stanie się przyciskiem połączenia na karcie. Przesuń kontakt, aby go usunąć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguém que saiba da tua diabetes — companheiro, familiar ou amigo. O número torna-se um botão de chamada no cartão. Desliza um contacto para o remover."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cineva care știe despre diabetul tău — partener, părinte sau prieten. Numărul devine un buton de apel pe card. Glisează un contact pentru a-l elimina."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тот, кто знает о вашем диабете, — партнёр, родитель или друг. Номер станет кнопкой вызова на карточке. Смахните контакт, чтобы удалить его."
          }
        }
      }
    },
