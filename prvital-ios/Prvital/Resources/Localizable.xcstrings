    "Evening lows appear often. Check your dinner dose and any late-day activity with your team." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abends kommt es häufig zu niedrigen Werten. Besprich deine Abenddosis und späte Aktivitäten mit deinem Team."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las bajadas por la noche son frecuentes. Revisa con tu equipo la dosis de la cena y cualquier actividad al final del día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les hypos du soir reviennent souvent. Vérifie ta dose du dîner et ton activité de fin de journée avec ton équipe soignante."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I cali serali si presentano spesso. Verifica la dose della cena e l'eventuale attività di fine giornata con il tuo team curante."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lage waarden in de avond komen vaak voor. Bespreek je avonddosis en eventuele late activiteiten met je team."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wieczorne spadki zdarzają się często. Omów ze swoim zespołem opieki dawkę na kolację i ewentualną aktywność pod koniec dnia."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As hipoglicemias ao final do dia são frequentes. Fala com a tua equipa sobre a dose do jantar e sobre atividade tardia."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hipoglicemiile de seară apar des. Discută cu echipa ta medicală despre doza de la cină și despre orice activitate de la finalul zilei."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вечерние понижения случаются часто. Обсуди со своей командой дозу на ужин и активность в конце дня."
          }
        }
      }
    },
    "Evening snack" : {
      "extractionState" : "manual",
