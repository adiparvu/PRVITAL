    "Data coverage is below 70%, so the estimated A1c (GMI) is less reliable for this period.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datenabdeckung liegt unter 70 %, daher ist der geschätzte A1c (GMI) für diesen Zeitraum weniger zuverlässig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cobertura de datos es inferior al 70%, por lo que la A1c estimada (GMI) es menos fiable para este periodo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La couverture des données est inférieure à 70 %, donc l'A1c estimée (GMI) est moins fiable pour cette période."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La copertura dati è inferiore al 70%, quindi l'A1c stimato (GMI) è meno affidabile per questo periodo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gegevensdekking is lager dan 70%, dus de geschatte A1c (GMI) is minder betrouwbaar voor deze periode."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokrycie danych jest poniżej 70%, więc szacowane A1c (GMI) jest mniej wiarygodne dla tego okresu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A cobertura de dados está abaixo de 70%, por isso a A1c estimada (GMI) é menos fiável para este período."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acoperirea datelor este sub 70%, așa că A1c estimat (GMI) este mai puțin fiabil pentru această perioadă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Охват данных ниже 70%, поэтому оценочный A1c (GMI) менее надёжен для этого периода."
          }
        }
      }
    },
