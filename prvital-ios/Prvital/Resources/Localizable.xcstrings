    "Typical glucose change during and after your activity — glucose often falls, so stay alert for lows. Based on %lld sessions.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Typische Glukoseänderung während und nach der Aktivität — die Glukose fällt oft, daher auf Tiefs achten. Basierend auf %lld Aktivitäten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambio típico de la glucosa durante y después de tu actividad — la glucosa suele bajar, así que mantente alerta ante las hipoglucemias. Basado en %lld sesiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Variation glycémique typique pendant et après votre activité — la glycémie baisse souvent, restez donc attentif aux hypoglycémies. D'après %lld séances."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Variazione tipica della glicemia durante e dopo l'attività — la glicemia spesso scende, quindi fai attenzione ai valori bassi. In base a %lld sessioni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Typische glucoseverandering tijdens en na je activiteit — glucose daalt vaak, dus blijf alert op lage waarden. Gebaseerd op %lld sessies."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Typowa zmiana glukozy w trakcie i po aktywności — glukoza często spada, więc uważaj na niedocukrzenia. Na podstawie %lld sesji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Variação típica da glicose durante e após a tua atividade — a glicose desce frequentemente, por isso mantém-te atento a mínimas. Com base em %lld sessões."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Schimbarea tipică a glicemiei în timpul și după activitate — glicemia scade adesea, deci fii atent la minime. Pe baza a %lld sesiuni."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Типичное изменение глюкозы во время и после активности — глюкоза часто падает, поэтому будьте внимательны к гипогликемии. На основе %lld сессий."
          }
        }
      }
    },
