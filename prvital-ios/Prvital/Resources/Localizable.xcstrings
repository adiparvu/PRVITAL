    "Glucose, insulin, meals and notes — clear at the size that suits you.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glucose, insulin, meals and notes — clear at the size that suits you."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Glucoză, insulină, mese și notițe — clare la mărimea care ți se potrivește."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Glukose, Insulin, Mahlzeiten und Notizen – klar in der Größe, die zu dir passt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Glucosa, insulina, comidas y notas: nítidas en el tamaño que mejor te vaya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glucose, insuline, repas et notes — nets à la taille qui vous convient."
