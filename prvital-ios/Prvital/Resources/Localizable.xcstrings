        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parola ta este păstrată doar în brelocul acestui dispozitiv și trimisă exclusiv serviciului pentru autentificare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш пароль хранится только в связке ключей этого устройства и отправляется исключительно сервису для входа."
          }
        }
      }
    },
