    "Ask for Face ID or your passcode every time the app opens, so your journal stays private even on an unlocked phone." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fragt bei jedem Öffnen nach Face ID oder deinem Code, damit dein Tagebuch auch auf einem entsperrten iPhone privat bleibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pide Face ID o tu código cada vez que se abre la app, para que tu diario siga siendo privado incluso con el teléfono desbloqueado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demande Face ID ou ton code à chaque ouverture, pour que ton journal reste privé même sur un téléphone déverrouillé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richiede Face ID o il codice a ogni apertura, così il diario resta privato anche su un telefono sbloccato."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vraagt bij elke opening om Face ID of je code, zodat je dagboek privé blijft, zelfs op een ontgrendelde telefoon."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prosi o Face ID lub kod przy każdym otwarciu, aby dziennik pozostał prywatny nawet na odblokowanym telefonie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pede Face ID ou o teu código sempre que a app abre, para o diário ficar privado mesmo num telemóvel desbloqueado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cere Face ID sau codul de fiecare dată când se deschide aplicația, ca jurnalul să rămână privat chiar și pe un telefon deblocat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запрашивает Face ID или код при каждом открытии, чтобы дневник оставался личным даже на разблокированном телефоне."
          }
        }
      }
    },
