    "Today's been bumpy, and that's okay — the next one is a new chance." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute war holprig, und das ist okay — der nächste Tag ist eine neue Chance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoy ha sido un día con altibajos, y no pasa nada — el próximo es una nueva oportunidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La journée a été en dents de scie, et ce n'est pas grave — la prochaine est une nouvelle chance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oggi è stata una giornata altalenante, e va bene così — la prossima è una nuova occasione."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vandaag ging het op en neer, en dat is oké — morgen is een nieuwe kans."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dzisiaj było nierówno i to w porządku — jutro to nowa szansa."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoje foi um dia com altos e baixos, e não faz mal — o próximo é uma nova oportunidade."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Azi a fost o zi cu urcușuri și coborâșuri, și e în regulă — următoarea e o nouă șansă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сегодня был непростой день, и это нормально — завтра будет новый шанс."
          }
        }
      }
    },
