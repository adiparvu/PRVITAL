    "Blood ketones are measured in mmol/L. Urine strips read differently — record the number your meter or strip shows.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blutketone werden in mmol/L gemessen. Urinteststreifen zeigen andere Werte an — trage die Zahl ein, die dein Messgerät oder Teststreifen anzeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cetonas en sangre se miden en mmol/L. Las tiras de orina se leen de forma diferente — registra el número que muestre tu medidor o tira."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cétones sanguines se mesurent en mmol/L. Les bandelettes urinaires se lisent différemment — note le chiffre affiché par ton lecteur ou ta bandelette."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I chetoni nel sangue si misurano in mmol/L. Le strisce per le urine si leggono in modo diverso — registra il numero indicato dal tuo misuratore o dalla striscia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketonen in bloed worden gemeten in mmol/L. Urinestrips lezen anders af — noteer het getal dat je meter of strip aangeeft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketony we krwi mierzy się w mmol/L. Paski moczowe pokazują wynik inaczej — zapisz liczbę, którą pokazuje Twój miernik lub pasek."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As cetonas no sangue medem-se em mmol/L. As tiras de urina são lidas de forma diferente — regista o número que o teu medidor ou tira indicar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cetonele din sânge se măsoară în mmol/L. Benzile de urină citesc diferit — notează numărul afișat de glucometru sau de bandă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кетоны крови измеряются в mmol/L. Тест-полоски для мочи показывают иначе — записывай то число, которое показывает твой глюкометр или полоска."
          }
        }
      }
    },
