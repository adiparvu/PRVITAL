    "Talk to your team about lowering insulin around planned activity rather than only chasing lows with food." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprich mit deinem Team darüber, das Insulin rund um geplante Aktivität zu reduzieren, statt Unterzuckerungen nur mit Essen hinterherzujagen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Habla con tu equipo sobre reducir la insulina en torno a la actividad planificada, en lugar de solo perseguir los bajones con comida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parle avec ton équipe de réduire l'insuline autour d'une activité prévue, plutôt que de seulement compenser les hypos avec de la nourriture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parla con il tuo team della possibilità di ridurre l'insulina in previsione dell'attività fisica, invece di rincorrere solo le ipoglicemie con il cibo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bespreek met je team of je de insuline kunt verlagen rondom geplande beweging, in plaats van lage waarden alleen met eten achterna te jagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porozmawiaj ze swoim zespołem o zmniejszeniu dawki insuliny wokół planowanej aktywności, zamiast wyrównywać niedocukrzenia wyłącznie jedzeniem."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fala com a tua equipa sobre reduzir a insulina em torno da atividade planeada, em vez de andares apenas a compensar hipoglicemias com comida."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discută cu echipa ta despre reducerea insulinei în jurul activității fizice planificate, în loc să tratezi hipoglicemiile doar cu mâncare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обсуди со своей командой снижение дозы инсулина перед плановой активностью, а не только «догонять» низкий уровень едой."
          }
        }
      }
    },
    "Tap Take when you've had a dose. It's logged to your journal." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf „Einnehmen“, wenn du eine Dosis genommen hast. Sie wird in deinem Journal protokolliert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca Tomar cuando hayas tomado una dosis. Se registra en tu diario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur Prendre lorsque vous avez pris une dose. C'est enregistré dans votre journal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca Assumi quando hai preso una dose. Viene registrato nel tuo diario."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op Innemen wanneer je een dosis hebt genomen. Het wordt in je dagboek vastgelegd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotknij Przyjmij, gdy przyjmiesz dawkę. Zostanie zapisane w twoim dzienniku."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca em Tomar quando tomares uma dose. Fica registado no teu diário."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apasă Ia când ai luat o doză. Se înregistrează în jurnalul tău."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите «Принять», когда примете дозу. Это записывается в ваш дневник."
          }
        }
      }
    },
    "Tap a dose to edit it — including which meal it belongs to." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf eine Dosis, um sie zu bearbeiten – auch, zu welcher Mahlzeit sie gehört."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca una dosis para editarla, incluida la comida a la que pertenece."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez une dose pour la modifier, y compris le repas auquel elle appartient."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca una dose per modificarla, incluso il pasto a cui appartiene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op een dosis om die te bewerken — ook bij welke maaltijd die hoort."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij dawkę, aby ją edytować — także posiłek, do którego należy."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque numa dose para a editar — incluindo a refeição a que pertence."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atinge o doză ca s-o editezi — inclusiv masa căreia îi aparține."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите на дозу, чтобы изменить её — в том числе к какому приёму пищи она относится."
          }
        }
      }
    },
    "Tap a field to search the device and insulin list, or type your own. Labels for your records and shared reports — Prvital never recommends insulin or doses." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a field to search the device and insulin list, or type your own. Labels for your records and shared reports — Prvital never recommends insulin or doses."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atinge un câmp pentru a căuta în lista de dispozitive și insuline, sau scrie-l pe al tău. Etichete pentru evidența ta și rapoartele partajate — Prvital nu recomandă niciodată insulină sau doze."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf ein Feld, um die Geräte- und Insulinliste zu durchsuchen, oder gib deinen eigenen Eintrag ein. Bezeichnungen für deine Aufzeichnungen und geteilten Berichte – Prvital empfiehlt niemals Insulin oder Dosen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca un campo para buscar en la lista de dispositivos e insulinas, o escribe el tuyo. Etiquetas para tus registros e informes compartidos: Prvital nunca recomienda insulina ni dosis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez un champ pour rechercher dans la liste des appareils et des insulines, ou saisissez le vôtre. Des étiquettes pour vos archives et vos rapports partagés — Prvital ne recommande jamais d'insuline ni de doses."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca un campo per cercare nell’elenco di dispositivi e insuline, oppure scrivi il tuo. Etichette per i tuoi appunti e i referti condivisi — Prvital non consiglia mai insulina o dosi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op een veld om in de lijst met apparaten en insulines te zoeken, of typ je eigen tekst. Labels voor je eigen dossier en gedeelde rapporten — Prvital beveelt nooit insuline of doses aan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotknij pola, aby przeszukać listę urządzeń i insulin, albo wpisz własny. Etykiety do Twoich zapisów i udostępnianych raportów — Prvital nigdy nie zaleca insuliny ani dawek."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca num campo para pesquisar na lista de dispositivos e insulinas, ou escreve o teu. Etiquetas para os teus registos e relatórios partilhados — o Prvital nunca recomenda insulina nem doses."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коснитесь поля, чтобы искать в списке устройств и инсулинов, или введите свой вариант. Метки для ваших записей и общих отчётов — Prvital никогда не рекомендует инсулин или дозы."
          }
        }
      }
    },
    "Tap a sound to hear it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf einen Ton, um ihn anzuhören."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca un sonido para escucharlo."
          }
        },
        "fr" : {
