    "Slightly raised. Drink water, recheck in a couple of hours, and follow your sick-day plan. Keep taking insulin." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leicht erhöht. Trink Wasser, kontrolliere in ein paar Stunden erneut und befolge deinen Krankheitstag-Plan. Nimm weiterhin dein Insulin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ligeramente elevadas. Bebe agua, vuelve a comprobar en un par de horas y sigue tu plan para días de enfermedad. Continúa tomando la insulina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Légèrement élevé. Bois de l'eau, revérifie dans quelques heures et suis ton plan pour les jours de maladie. Continue de prendre ton insuline."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leggermente elevati. Bevi acqua, ricontrolla tra un paio d'ore e segui il tuo piano per i giorni di malattia. Continua a fare l'insulina."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Licht verhoogd. Drink water, controleer over een paar uur opnieuw en volg je ziektedagplan. Blijf insuline gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lekko podwyższony. Pij wodę, sprawdź ponownie za kilka godzin i postępuj zgodnie ze swoim planem na dni choroby. Nie przerywaj przyjmowania insuliny."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ligeiramente elevado. Bebe água, verifica novamente daqui a umas horas e segue o teu plano para dias de doença. Continua a tomar insulina."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ușor crescute. Bea apă, remăsoară peste câteva ore și urmează-ți planul pentru zilele de boală. Continuă să iei insulină."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Немного повышены. Пей воду, перепроверь через пару часов и следуй своему плану на случай болезни. Продолжай принимать инсулин."
          }
        }
      }
    },
    "Small, steady wins add up. Keep going." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kleine, stetige Erfolge summieren sich. Bleib dran."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los pequeños logros constantes suman. Sigue así."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les petites victoires régulières s'additionnent. Continuez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I piccoli successi costanti si sommano. Continua così."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kleine, gestage successen tellen op. Ga zo door."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Małe, systematyczne sukcesy się sumują. Tak trzymaj."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As pequenas vitórias constantes somam-se. Continua assim."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Micile reușite constante se adună. Continuă tot așa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Маленькие, но регулярные победы складываются. Продолжайте в том же духе."
          }
        }
      }
    },
