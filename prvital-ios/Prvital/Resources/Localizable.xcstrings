    "If I can't swallow or am unconscious": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ich nicht schlucken kann oder bewusstlos bin"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no puedo tragar o estoy inconsciente"
          }
        },
        "fr": {
          "stringUnit": {
