          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi dati"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jouw gegevens"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje dane"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os teus dados"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Datele tale"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши данные"
          }
        }
      }
    },
    "Your medical data stays on your device and is never sold or used for advertising. Nothing is shared until you explicitly grant a permission below, and you stay in control of each one.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die medizinischen Daten verbleiben auf dem Gerät und werden nie verkauft oder für Werbung genutzt. Nichts wird geteilt, bis unten ausdrücklich eine Berechtigung erteilt wird, und die Kontrolle über jede einzelne bleibt erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus datos médicos permanecen en tu dispositivo y nunca se venden ni se usan con fines publicitarios. No se comparte nada hasta que concedas explícitamente un permiso más abajo, y mantienes el control de cada uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données médicales restent sur votre appareil et ne sont jamais vendues ni utilisées à des fins publicitaires. Rien n'est partagé tant que vous n'accordez pas explicitement une autorisation ci-dessous, et vous gardez le contrôle de chacune."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi dati medici restano sul tuo dispositivo e non vengono mai venduti o usati per la pubblicità. Nulla viene condiviso finché non concedi esplicitamente un'autorizzazione qui sotto, e mantieni il controllo di ciascuna."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je medische gegevens blijven op je apparaat en worden nooit verkocht of gebruikt voor advertenties. Er wordt niets gedeeld totdat je hieronder expliciet toestemming geeft, en jij houdt controle over elke afzonderlijke toestemming."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje dane medyczne pozostają na urządzeniu i nigdy nie są sprzedawane ani wykorzystywane do reklam. Nic nie jest udostępniane, dopóki wyraźnie nie przyznasz uprawnienia poniżej, a kontrolę nad każdym z nich zachowujesz Ty."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os teus dados médicos ficam no teu dispositivo e nunca são vendidos ou usados para publicidade. Nada é partilhado até que concedas explicitamente uma permissão abaixo, e manténs o controlo de cada uma."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Datele tale medicale rămân pe dispozitiv și nu sunt niciodată vândute sau folosite pentru publicitate. Nimic nu este partajat până când nu acorzi explicit o permisiune mai jos, iar controlul asupra fiecăreia rămâne la tine."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши медицинские данные остаются на вашем устройстве и никогда не продаются и не используются для рекламы. Ничем не делятся, пока вы явно не предоставите разрешение ниже, и вы сохраняете контроль над каждым из них."
          }
        }
      }
    },
    "Your primary source labels every reading's provenance and wins when two sources report the same moment. You can change it at any time without losing data.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die primäre Quelle kennzeichnet die Herkunft jedes Messwerts und hat Vorrang, wenn zwei Quellen denselben Moment melden. Sie lässt sich jederzeit ändern, ohne Daten zu verlieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu fuente principal etiqueta la procedencia de cada lectura y tiene prioridad cuando dos fuentes informan del mismo momento. Puedes cambiarla en cualquier momento sin perder datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre source principale indique la provenance de chaque mesure et l'emporte lorsque deux sources rapportent le même instant. Vous pouvez la changer à tout moment sans perdre de données."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua origine principale etichetta la provenienza di ogni lettura e prevale quando due origini riportano lo stesso momento. Puoi cambiarla in qualsiasi momento senza perdere dati."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je primaire bron labelt de herkomst van elke meting en krijgt voorrang wanneer twee bronnen hetzelfde moment melden. Je kunt deze op elk moment wijzigen zonder gegevens te verliezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje główne źródło oznacza pochodzenie każdego odczytu i ma pierwszeństwo, gdy dwa źródła zgłaszają ten sam moment. Możesz je zmienić w każdej chwili bez utraty danych."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua fonte principal etiqueta a proveniência de cada leitura e prevalece quando duas fontes reportam o mesmo momento. Podes alterá-la a qualquer momento sem perder dados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sursa ta principală etichetează proveniența fiecărei citiri și are prioritate când două surse raportează același moment. O poți schimba oricând, fără a pierde date."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш основной источник помечает происхождение каждого измерения и имеет приоритет, когда два источника сообщают об одном и том же моменте. Вы можете изменить его в любой момент без потери данных."
          }
        }
      }
    },
    "Your records are health data. Handle exports and backups with the same care you'd give any medical information.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die eigenen Aufzeichnungen sind Gesundheitsdaten. Exporte und Backups mit derselben Sorgfalt behandeln wie jede andere medizinische Information."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus registros son datos de salud. Trata las exportaciones y las copias de seguridad con el mismo cuidado que darías a cualquier información médica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos enregistrements sont des données de santé. Traitez les exports et les sauvegardes avec le même soin que toute information médicale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi record sono dati sanitari. Gestisci esportazioni e backup con la stessa cura che riserveresti a qualsiasi informazione medica."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je registraties zijn gezondheidsgegevens. Behandel exports en back-ups met dezelfde zorg als je aan alle medische informatie zou geven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje rekordy to dane zdrowotne. Traktuj eksporty i kopie zapasowe z taką samą troską jak każdą informację medyczną."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os teus registos são dados de saúde. Trata as exportações e as cópias de segurança com o mesmo cuidado que darias a qualquer informação médica."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrările tale sunt date medicale. Tratează exporturile și copiile de rezervă cu aceeași grijă pe care ai acorda-o oricărei informații medicale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши записи — это медицинские данные. Обращайтесь с экспортами и резервными копиями так же бережно, как с любой медицинской информацией."
          }
        }
      }
    },
