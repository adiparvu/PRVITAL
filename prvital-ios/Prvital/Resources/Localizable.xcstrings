    "Ketones are in the normal range. Keep hydrated and carry on with your usual routine." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Ketonwerte liegen im normalen Bereich. Trink ausreichend und führe deine gewohnte Routine fort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las cetonas están dentro del rango normal. Bebe suficiente agua y continúa con tu rutina habitual."
