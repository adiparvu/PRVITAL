    "Aligned with American Diabetes Association and Diabetes UK hypoglycaemia guidance." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orientiert an den Hypoglykämie-Leitlinien der American Diabetes Association und von Diabetes UK."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alineado con las pautas de hipoglucemia de la American Diabetes Association y Diabetes UK."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conforme aux recommandations sur l'hypoglycémie de l'American Diabetes Association et de Diabetes UK."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In linea con le linee guida sull'ipoglicemia di American Diabetes Association e Diabetes UK."
