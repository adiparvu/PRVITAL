    "All optional — kept only for your own record and the clinician report. Prvital never uses them to calculate or suggest doses.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles optional – nur für deine eigenen Aufzeichnungen und den Arztbericht. Prvital verwendet sie nie, um Dosen zu berechnen oder vorzuschlagen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo opcional: se guarda solo para tu propio registro y el informe médico. Prvital nunca los usa para calcular ni sugerir dosis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout est facultatif — conservé uniquement pour vos propres archives et le rapport médical. Prvital ne les utilise jamais pour calculer ou suggérer des doses."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto facoltativo — conservato solo per i tuoi appunti e il referto medico. Prvital non li usa mai per calcolare o suggerire dosi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles optioneel — alleen bewaard voor je eigen dossier en het artsenrapport. Prvital gebruikt ze nooit om doses te berekenen of voor te stellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko opcjonalne — przechowywane tylko na Twój własny użytek i do raportu dla lekarza. Prvital nigdy nie używa ich do obliczania ani proponowania dawek."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo opcional — guardado apenas para o teu próprio registo e o relatório clínico. O Prvital nunca os usa para calcular ou sugerir doses."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Totul opțional — păstrat doar pentru evidența ta și pentru raportul medical. Prvital nu le folosește niciodată pentru a calcula sau sugera doze."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё необязательно — хранится только для ваших записей и отчёта для врача. Prvital никогда не использует их для расчёта или предложения доз."
          }
        }
      }
    },
