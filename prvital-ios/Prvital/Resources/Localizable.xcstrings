    "Ketones are in the normal range. Keep hydrated and carry on with your usual routine.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ketonwerte liegen im normalen Bereich. Trink ausreichend und führe deine gewohnte Routine fort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cetonas están dentro del rango normal. Bebe suficiente agua y continúa con tu rutina habitual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cétones sont dans la normale. Reste bien hydraté(e) et poursuis ta routine habituelle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I chetoni sono nel range normale. Bevi a sufficienza e continua con la tua routine abituale."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketonen zijn binnen het normale bereik. Blijf voldoende drinken en ga door met je gebruikelijke routine."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketony mieszczą się w normie. Pij dużo płynów i kontynuuj swoją zwykłą rutynę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As cetonas estão dentro do intervalo normal. Mantém-te hidratado e continua com a tua rotina habitual."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cetonele sunt în intervalul normal. Hidratează-te bine și continuă-ți rutina obișnuită."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кетоны в норме. Пей достаточно воды и продолжай в обычном режиме."
          }
        }
      }
    },
