            "state": "translated",
            "value": "Verfolge einen Zielwert für Zeit im Zielbereich und A1c – mit einer Serie von Tagen, die dein TIR-Ziel erreichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue un objetivo de tiempo en rango y A1c, con una racha de días que cumplen tu objetivo de TIR."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez un objectif de temps dans la cible et d'A1c, avec une série de jours qui atteignent votre objectif de TIR."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitora un obiettivo di tempo nell'intervallo e A1c, con una serie di giorni che raggiungono il tuo obiettivo di TIR."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volg een doel voor tijd binnen bereik en A1c, met een reeks dagen die je TIR-doel halen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Śledź docelowy czas w zakresie i A1c oraz serię dni, w których osiągasz swój cel TIR."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Acompanhe um objetivo de tempo dentro do intervalo e de A1c, com uma sequência de dias que cumprem o seu objetivo de TIR."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Urmărește un obiectiv pentru timpul în interval și A1c, cu o serie de zile în care îți atingi obiectivul TIR."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отслеживайте целевые показатели времени в диапазоне и A1c, а также серию дней, когда достигается ваша цель по времени в диапазоне (TIR)."
          }
        }
      }
    },
