    "Larger differences than typical — check sensor placement or calibrate per the manufacturer's instructions.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Größere Abweichungen als üblich – Sitz des Sensors prüfen oder gemäß Herstellerangaben kalibrieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Diferencias mayores de lo habitual: comprueba la colocación del sensor o calíbralo según las instrucciones del fabricante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écarts plus importants que d'habitude — vérifiez la pose du capteur ou étalonnez selon les instructions du fabricant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Differenze maggiori del solito — controlla il posizionamento del sensore o calibra secondo le istruzioni del produttore."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Grotere verschillen dan gebruikelijk — controleer de plaatsing van de sensor of kalibreer volgens de instructies van de fabrikant."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Większe różnice niż zwykle — sprawdź umiejscowienie sensora lub skalibruj zgodnie z instrukcją producenta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Diferenças maiores do que o habitual — verifica a colocação do sensor ou calibra segundo as instruções do fabricante."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Diferențe mai mari decât de obicei — verifică poziționarea senzorului sau calibrează conform instrucțiunilor producătorului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отклонения больше обычного — проверьте установку сенсора или откалибруйте согласно инструкции производителя."
          }
        }
      }
    },
