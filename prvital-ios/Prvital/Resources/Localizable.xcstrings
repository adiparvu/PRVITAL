    "Every record on this device will be permanently removed. This cannot be undone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Datensatz auf diesem Gerät wird dauerhaft entfernt. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los registros de este dispositivo se eliminarán de forma permanente. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque enregistrement de cet appareil sera définitivement supprimé. Cette action est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni record su questo dispositivo verrà rimosso definitivamente. L'operazione non può essere annullata."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke registratie op dit apparaat wordt definitief verwijderd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy rekord na tym urządzeniu zostanie trwale usunięty. Tej operacji nie można cofnąć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os registos neste dispositivo serão removidos permanentemente. Esta ação não pode ser anulada."
          }
