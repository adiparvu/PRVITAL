          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duur"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czas trwania"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
