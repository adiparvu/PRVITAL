    "Lows take about %lld min to return to range over %lld episodes": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiefs brauchen etwa %lld Min., um über %lld Episoden in den Zielbereich zurückzukehren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las bajadas tardan unos %lld min en volver al rango en %lld episodios"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les hypos mettent environ %lld min à revenir dans la cible sur %lld épisodes"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli ipo impiegano circa %lld min per rientrare nell'intervallo in %lld episodi"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hypo's doen er ongeveer %lld min over om terug in bereik te komen over %lld episodes"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niedocukrzenia wracają do zakresu w około %lld min w %lld epizodach"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As baixas demoram cerca de %lld min a regressar ao intervalo em %lld episódios"
