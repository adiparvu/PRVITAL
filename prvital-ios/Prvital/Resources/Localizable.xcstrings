          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ontem desenhado como uma linha ténue sob o gráfico de hoje."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziua de ieri, ca o linie discretă sub graficul de azi."
          }
