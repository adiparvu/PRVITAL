            "value": "Si je ne peux pas avaler ou suis inconscient"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se non riesco a deglutire o sono incosciente"
          }
        },
        "nl": {
          "stringUnit": {
