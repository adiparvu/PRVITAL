    "A helper who has never seen a glucagon kit needs to find yours fast. Name the exact place.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer noch nie ein Glukagon-Set gesehen hat, muss deins schnell finden. Nenne den genauen Ort."
          }
        },
        "es": {
