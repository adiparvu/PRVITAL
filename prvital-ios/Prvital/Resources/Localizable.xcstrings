    "A very low-carb, filling breakfast or quick dinner." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein sehr kohlenhydratarmes, sättigendes Frühstück oder schnelles Abendessen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un desayuno o cena rápida muy bajo en carbohidratos y saciante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un petit-déjeuner très pauvre en glucides et rassasiant, ou un dîner rapide."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una colazione o cena veloce molto povera di carboidrati e saziante."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een zeer koolhydraatarm, vullend ontbijt of snel avondeten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bardzo niskowęglowodanowe, sycące śniadanie lub szybka kolacja."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um pequeno-almoço ou jantar rápido muito pobre em hidratos de carbono e bastante saciante."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un mic dejun sau o cină rapidă, foarte săracă în carbohidrați și sățioasă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Очень низкоуглеводный, сытный завтрак или быстрый ужин."
          }
        }
      }
    },
    "A widely-quoted target is to spend around 70% or more of the day in range, with as little time below range as possible. Your personal targets may differ — for example during pregnancy or for young children." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein häufig genanntes Ziel ist, rund 70% oder mehr des Tages im Zielbereich zu verbringen, bei möglichst wenig Zeit unterhalb des Bereichs. Deine persönlichen Ziele können abweichen — zum Beispiel während der Schwangerschaft oder bei kleinen Kindern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un objetivo muy citado es pasar alrededor del 70% o más del día en rango, con el menor tiempo posible por debajo del rango. Tus objetivos personales pueden ser diferentes — por ejemplo durante el embarazo o en niños pequeños."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un objectif souvent cité est de passer environ 70% ou plus de la journée dans la cible, avec le moins de temps possible en dessous. Tes objectifs personnels peuvent différer — par exemple pendant une grossesse ou chez les jeunes enfants."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un obiettivo spesso citato è trascorrere circa il 70% o più della giornata nell'intervallo, con il minor tempo possibile sotto l'intervallo. I tuoi obiettivi personali possono essere diversi — ad esempio in gravidanza o per i bambini piccoli."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een veelgenoemd streefdoel is om ongeveer 70% of meer van de dag binnen bereik te zitten, met zo min mogelijk tijd onder bereik. Jouw persoonlijke streefwaarden kunnen afwijken — bijvoorbeeld tijdens de zwangerschap of bij jonge kinderen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Często przywoływanym celem jest spędzanie co najmniej około 70% doby w zakresie, przy jak najmniejszej ilości czasu poniżej zakresu. Twoje osobiste cele mogą się różnić — na przykład w ciąży lub u małych dzieci."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um objetivo frequentemente citado é passar cerca de 70% ou mais do dia dentro do intervalo, com o mínimo de tempo possível abaixo do intervalo. Os teus objetivos pessoais podem ser diferentes — por exemplo, durante a gravidez ou no caso de crianças pequenas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O țintă des menționată este să petreci în interval cel puțin aproximativ 70% din zi, cu cât mai puțin timp posibil sub interval. Țintele tale personale pot fi diferite — de exemplu în timpul sarcinii sau pentru copiii mici."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Часто упоминаемая цель — проводить в диапазоне около 70% дня или больше, при этом сводя время ниже диапазона к минимуму. Твои личные цели могут отличаться — например, во время беременности или для маленьких детей."
          }
        }
      }
    },
