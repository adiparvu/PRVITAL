          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het deelvenster bevat Afdrukken — kies dit om het register op papier mee te nemen naar je arts."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
