    "There aren't enough readings yet to sum up your %@. Keep logging and this fills in." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es gibt noch nicht genug Messwerte, um %@ zusammenzufassen. Miss weiter, dann füllt sich das."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todavía no hay suficientes lecturas para resumir tu %@. Sigue registrando y esto se irá completando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n'y a pas encore assez de relevés pour faire le bilan de ta période (%@). Continue à enregistrer tes données : ça se complète petit à petit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non ci sono ancora abbastanza rilevazioni per riassumere i dati di %@. Continua a registrare e il quadro si completerà."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er zijn nog niet genoeg metingen om je %@ samen te vatten. Blijf loggen, dan vult dit zich aan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie masz jeszcze wystarczająco dużo odczytów, by podsumować Twój %@. Notuj dalej, a dane się uzupełnią."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda não há leituras suficientes para resumir o teu período (%@). Continua a registar e isto vai-se completando."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
