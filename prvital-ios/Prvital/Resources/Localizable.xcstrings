    "Mark when you insert a sensor to see its warm-up and a countdown to when it needs replacing.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markieren, wann ein Sensor eingesetzt wird, um dessen Aufwärmphase und einen Countdown bis zum fälligen Wechsel zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca cuándo insertas un sensor para ver su calentamiento y una cuenta atrás hasta que haya que reemplazarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez quand vous posez un capteur pour voir sa phase de préchauffage et un compte à rebours jusqu'à son remplacement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segna quando inserisci un sensore per vedere il riscaldamento e un conto alla rovescia fino a quando va sostituito."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Markeer wanneer je een sensor inbrengt om de opwarmtijd te zien en een aftelling tot deze vervangen moet worden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznacz moment założenia sensora, aby zobaczyć jego rozgrzewanie i odliczanie do wymiany."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque quando insere um sensor para ver o aquecimento e uma contagem decrescente até ser necessário substituí-lo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Marchează când introduci un senzor ca să vezi perioada de încălzire și cât mai e până trebuie înlocuit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметьте, когда вы устанавливаете сенсор, чтобы видеть его прогрев и обратный отсчёт до замены."
          }
        }
      }
    },
