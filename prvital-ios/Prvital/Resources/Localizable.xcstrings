    "Sync CGM readings from your own Nightscout site over the internet — no vendor account required.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CGM-Messwerte vom eigenen Nightscout-Server über das Internet synchronisieren — kein Herstellerkonto erforderlich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincroniza las lecturas del CGM desde tu propio sitio Nightscout por internet — sin necesidad de una cuenta de proveedor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisez les mesures CGM depuis votre propre site Nightscout via Internet — aucun compte fournisseur requis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizza le letture CGM dal tuo sito Nightscout tramite internet — nessun account del fornitore richiesto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchroniseer CGM-metingen van je eigen Nightscout-site via internet — geen leveranciersaccount vereist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizuj odczyty CGM z własnej witryny Nightscout przez internet — bez konta u dostawcy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincroniza as leituras CGM do teu próprio site Nightscout através da internet — não é necessária uma conta de fornecedor."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizează citirile CGM de pe propriul site Nightscout prin internet — fără cont de furnizor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизируйте измерения CGM с вашего собственного сайта Nightscout через интернет — учётная запись поставщика не требуется."
          }
        }
      }
    },
