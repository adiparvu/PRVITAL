    "Rose %@ less than your last %@ (%@)." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stieg %@ weniger an als bei deinem letzten %@ (%@)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subió %@ menos que tu %@ anterior (%@)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta glycémie a augmenté de %@ de moins que lors de ta période précédente (%@), soit %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È salita di %@ in meno rispetto al tuo ultimo %@ (%@)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steeg %@ minder dan je vorige %@ (%@)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wzrost o %@ mniejszy niż ostatnio: %@ (%@)."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subiu %@ menos do que no último período: %@ (%@)."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A crescut cu %@ mai puțin decât data trecută la %@ (%@)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подъём на %@ меньше, чем в прошлый %@ (%@)."
          }
        }
      }
    },
