    "On more active days, your glucose tends to run higher." : {
      "extractionState" : "manual",
      "localizations" : {
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "În zilele mai active, glicemia tinde să fie mai mare."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An aktiveren Tagen ist dein Glukosewert tendenziell höher."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En los días más activos, tu glucosa suele ser más alta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les jours plus actifs, votre glycémie a tendance à être plus élevée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nei giorni più attivi, la glicemia tende a essere più alta."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Op actievere dagen is je glucose meestal hoger."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W bardziej aktywne dni glikemia zwykle jest wyższa."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nos dias mais ativos, a tua glicose tende a ser mais alta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В более активные дни глюкоза обычно выше."
          }
        }
      }
    },
    "On more active days, your glucose tends to run lower." : {
      "extractionState" : "manual",
      "localizations" : {
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "În zilele mai active, glicemia tinde să fie mai mică."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An aktiveren Tagen ist dein Glukosewert tendenziell niedriger."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En los días más activos, tu glucosa suele ser más baja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les jours plus actifs, votre glycémie a tendance à être plus basse."
          }
        },
        "it" : {
