    "Pick a symbol and a colour. Once you've added your name, your initials take the symbol's place." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle ein Symbol und eine Farbe. Sobald du deinen Namen hinzugefügt hast, treten deine Initialen an die Stelle des Symbols."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un símbolo y un color. Una vez que hayas añadido tu nombre, tus iniciales ocupan el lugar del símbolo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un symbole et une couleur. Une fois votre nom ajouté, vos initiales remplacent le symbole."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli un simbolo e un colore. Dopo aver aggiunto il tuo nome, le tue iniziali prendono il posto del simbolo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies een symbool en een kleur. Zodra je je naam hebt toegevoegd, komen je initialen op de plaats van het symbool."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz symbol i kolor. Gdy dodasz swoje imię, Twoje inicjały zajmą miejsce symbolu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolhe um símbolo e uma cor. Depois de adicionares o teu nome, as tuas iniciais ocupam o lugar do símbolo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alege un simbol și o culoare. După ce îți adaugi numele, inițialele tale iau locul simbolului."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите символ и цвет. Как только вы добавите имя, ваши инициалы займут место символа."
          }
        }
      }
    },
    "Pick which events appear as markers on the glucose chart. Each has its own colour and symbol." : {
      "extractionState" : "manual",
