    "See last week's time in range, best day and more.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh dir Zeit im Zielbereich, besten Tag und mehr der letzten Woche an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira el tiempo en rango, el mejor día y más de la semana pasada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Découvrez le temps dans la cible, le meilleur jour et plus encore de la semaine dernière."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda il tempo nell'intervallo, il giorno migliore e altro della settimana scorsa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk de tijd binnen bereik, beste dag en meer van vorige week."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobacz czas w zakresie, najlepszy dzień i więcej z ubiegłego tygodnia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vê o tempo dentro do intervalo, o melhor dia e mais da semana passada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vezi timpul în interval, cea mai bună zi și altele din săptămâna trecută."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посмотрите время в целевом диапазоне, лучший день и другое за прошлую неделю."
          }
        }
      }
    },
