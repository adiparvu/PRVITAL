      }
    },
    "A helper who has never seen a glucagon kit needs to find yours fast. Name the exact place.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer noch nie ein Glukagon-Set gesehen hat, muss deins schnell finden. Nenne den genauen Ort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quien nunca haya visto un kit de glucagón necesita encontrar el tuyo rápido. Indica el lugar exacto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une personne qui n'a jamais vu de kit de glucagon doit trouver le vôtre vite. Indiquez l'endroit exact."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi non ha mai visto un kit di glucagone deve trovare il tuo in fretta. Indica il punto esatto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een helper die nog nooit een glucagonset heeft gezien, moet die van jou snel vinden. Noem de exacte plek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Osoba, która nigdy nie widziała zestawu z glukagonem, musi szybko znaleźć Twój. Podaj dokładne miejsce."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quem nunca viu um kit de glucagon precisa de encontrar o teu depressa. Indica o local exato."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cineva care n-a văzut niciodată un kit de glucagon trebuie să-l găsească rapid pe al tău. Numește locul exact."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тому, кто никогда не видел набор с глюкагоном, нужно быстро найти ваш. Укажите точное место."
          }
        }
      }
    },
    "A log of every sensitive action": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Protokoll jeder sensiblen Aktion"
