    "For context only — your lab test is the reference. Discuss any gap with your care team.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur zur Orientierung — dein Labortest ist die Referenz. Besprich jede Abweichung mit deinem Behandlungsteam."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo como referencia — tu análisis de laboratorio es el valor de referencia. Comenta cualquier diferencia con tu equipo médico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À titre indicatif seulement — ton test en laboratoire fait référence. Parle de tout écart avec ton équipe soignante."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo per riferimento — il tuo esame di laboratorio resta il valore di riferimento. Parla di eventuali differenze con il tuo team curante."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen ter context — je labtest blijft de referentie. Bespreek eventuele verschillen met je behandelteam."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko dla kontekstu — wynik z laboratorium jest wartością odniesienia. Wszelkie różnice omów ze swoim zespołem opieki."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas para contexto — o teu exame laboratorial é a referência. Fala com a tua equipa sobre qualquer diferença."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar pentru context — testul tău de laborator este referința. Discută orice diferență cu echipa ta medicală."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только для ориентира — эталоном служит твой лабораторный анализ. Любое расхождение стоит обсудить с лечащей командой."
          }
        }
      }
    },
