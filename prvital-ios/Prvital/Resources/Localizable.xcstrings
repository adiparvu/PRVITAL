    "Tap Take when you've had a dose. It's logged to your journal.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf „Einnehmen“, wenn du eine Dosis genommen hast. Sie wird in deinem Journal protokolliert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Tomar cuando hayas tomado una dosis. Se registra en tu diario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur Prendre lorsque vous avez pris une dose. C'est enregistré dans votre journal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca Assumi quando hai preso una dose. Viene registrato nel tuo diario."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op Innemen wanneer je een dosis hebt genomen. Het wordt in je dagboek vastgelegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij Przyjmij, gdy przyjmiesz dawkę. Zostanie zapisane w twoim dzienniku."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca em Tomar quando tomares uma dose. Fica registado no teu diário."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apasă Ia când ai luat o doză. Se înregistrează în jurnalul tău."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите «Принять», когда примете дозу. Это записывается в ваш дневник."
          }
        }
      }
    },
    "The times of day you take this. Each one can send a reminder.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Uhrzeiten, zu denen du dies einnimmst. Jede kann eine Erinnerung senden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las horas del día a las que lo tomas. Cada una puede enviar un recordatorio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les heures de la journée où vous le prenez. Chacune peut envoyer un rappel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli orari della giornata in cui lo assumi. Ognuno può inviare un promemoria."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tijdstippen waarop je dit inneemt. Elk kan een herinnering sturen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
