    "A projection, not a prediction — talk to your care team before changing therapy.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Hochrechnung, keine Vorhersage — sprich mit deinem Behandlungsteam, bevor du die Therapie änderst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es una proyección, no una predicción: habla con tu equipo médico antes de cambiar el tratamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une projection, pas une prédiction — parlez-en à votre équipe soignante avant de modifier le traitement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una proiezione, non una previsione: parla con il tuo team di cura prima di cambiare la terapia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een projectie, geen voorspelling — overleg met je zorgteam voordat je de therapie aanpast."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To projekcja, nie przewidywanie — porozmawiaj z zespołem opieki, zanim zmienisz terapię."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma projeção, não uma previsão — fala com a tua equipa de cuidados antes de mudar a terapêutica."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O proiecție, nu o predicție — vorbește cu echipa ta de îngrijire înainte să schimbi terapia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это проекция, а не прогноз — обсудите с вашей лечащей командой, прежде чем менять терапию."
          }
        }
      }
    },
    "A quick reading keeps your trend complete.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein schneller Messwert hält den Trend vollständig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una lectura rápida mantiene tu tendencia completa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une mesure rapide garde votre tendance complète."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una lettura rapida mantiene completo il tuo andamento."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een snelle meting houdt je trend compleet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szybki odczyt dopełnia Twój trend."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma leitura rápida mantém a tua tendência completa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O citire rapidă îți menține tendința completă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Быстрое измерение сохраняет полноту вашего тренда."
          }
        }
      }
    },
    "A quiet local notification when your week in review is ready. The digest itself is computed on your device when you open it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine dezente lokale Mitteilung, wenn dein Wochenrückblick bereit ist. Der Rückblick selbst wird beim Öffnen auf deinem Gerät berechnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una notificación local discreta cuando tu resumen de la semana esté listo. El resumen en sí se calcula en tu dispositivo al abrirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une notification locale discrète quand votre bilan de la semaine est prêt. Le bilan lui-même est calculé sur votre appareil quand vous l'ouvrez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una notifica locale discreta quando la tua settimana in sintesi è pronta. La sintesi viene calcolata sul tuo dispositivo quando la apri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een rustige lokale melding wanneer je weekoverzicht klaarstaat. Het overzicht zelf wordt op je apparaat berekend wanneer je het opent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dyskretne lokalne powiadomienie, gdy podsumowanie tygodnia będzie gotowe. Samo podsumowanie jest obliczane na Twoim urządzeniu przy otwarciu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma notificação local discreta quando o teu resumo da semana estiver pronto. O resumo em si é calculado no teu dispositivo quando o abres."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O notificare locală discretă când rezumatul săptămânii tale este gata. Rezumatul în sine este calculat pe dispozitivul tău când îl deschizi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тихое локальное уведомление, когда итоги недели готовы. Сами итоги вычисляются на вашем устройстве при открытии."
          }
        }
      }
    },
