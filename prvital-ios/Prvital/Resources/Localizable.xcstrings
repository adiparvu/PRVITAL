    "Recheck your glucose. If it's still below 70 mg/dL, take another 15 g of fast carbs and wait 15 minutes again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miss deinen Glukosewert erneut. Liegt er weiterhin unter 70 mg/dL, nimm noch einmal 15 g schnelle Kohlenhydrate und warte erneut 15 Minuten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a comprobar tu glucosa. Si sigue por debajo de 70 mg/dL, toma otros 15 g de carbohidratos rápidos y espera otros 15 minutos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recontrôle ta glycémie. Si elle est toujours inférieure à 70 mg/dL, reprends 15 g de glucides rapides et attends encore 15 minutes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricontrolla la glicemia. Se è ancora inferiore a 70 mg/dL, assumi altri 15 g di carboidrati rapidi e aspetta di nuovo 15 minuti."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controleer je glucose opnieuw. Is deze nog steeds onder 70 mg/dL, neem dan nog eens 15 g snelle koolhydraten en wacht weer 15 minuten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdź ponownie poziom glukozy. Jeśli nadal jest poniżej 70 mg/dL, przyjmij kolejne 15 g szybkich węglowodanów i znowu odczekaj 15 minut."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volta a verificar a tua glicose. Se continuar abaixo de 70 mg/dL, toma mais 15 g de hidratos de carbono rápidos e espera mais 15 minutos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reverifică-ți glicemia. Dacă este încă sub 70 mg/dL, ia încă 15 g de carbohidrați rapizi și așteaptă din nou 15 minute."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверь глюкозу ещё раз. Если она всё ещё ниже 70 mg/dL, съешь ещё 15 г быстрых углеводов и снова подожди 15 минут."
          }
        }
      }
    },
