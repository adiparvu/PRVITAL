    "How much of the day you aim to have CGM data for. Consensus calls 70% or more reliable for statistics.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für welchen Anteil des Tages du CGM-Daten haben möchtest. Der Konsens hält 70% oder mehr für statistisch zuverlässig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué parte del día quieres tener datos de CGM. El consenso considera fiable el 70% o más para las estadísticas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle part de la journée vous souhaitez disposer de données CGM. Le consensus juge fiable 70% ou plus pour les statistiques."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per quale parte della giornata vuoi avere dati CGM. Il consenso ritiene affidabile il 70% o più per le statistiche."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor welk deel van de dag je CGM-gegevens wilt hebben. De consensus noemt 70% of meer betrouwbaar voor statistieken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dla jakiej części dnia chcesz mieć dane CGM. Konsensus uznaje 70% lub więcej za wiarygodne dla statystyk."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Que parte do dia queres ter dados de CGM. O consenso considera fiável 70% ou mais para as estatísticas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru cât din zi vrei să ai date CGM. Consensul consideră 70% sau mai mult fiabil pentru statistici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Какую часть дня вы хотите иметь данные CGM. По общему мнению, 70% или больше надёжно для статистики."
          }
        }
      }
    },
