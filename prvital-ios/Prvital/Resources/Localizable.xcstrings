    "Simmer for about 30 minutes until the lentils are tender." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwa 30 Minuten köcheln lassen, bis die Linsen weich sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cocina a fuego lento durante unos 30 minutos hasta que las lentejas estén tiernas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laisse mijoter environ 30 minutes, jusqu'à ce que les lentilles soient tendres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai sobbollire per circa 30 minuti finché le lenticchie sono tenere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat ongeveer 30 minuten sudderen tot de linzen zacht zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gotuj na wolnym ogniu przez około 30 minut, aż soczewica zmięknie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixa cozinhar em lume brando cerca de 30 minutos, até as lentilhas ficarem tenras."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fierbe la foc mic aproximativ 30 de minute, până când lintea este fragedă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вари на медленном огне около 30 минут, пока чечевица не станет мягкой."
          }
        }
      }
    },
