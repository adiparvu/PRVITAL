    "Eat cold, or warm through in the morning." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalt genießen oder am Morgen kurz erwärmen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cómelo frío, o caliéntalo por la mañana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déguste froid, ou réchauffe légèrement le matin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consuma freddo, oppure riscalda leggermente al mattino."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eet koud, of warm 's ochtends even op."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
