    "Readings and entries you log will appear here.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Messwerte und Einträge, die du erfasst, erscheinen hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las lecturas y entradas que registres aparecerán aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mesures et saisies que vous enregistrez apparaîtront ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le letture e le voci che registri appariranno qui."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Metingen en invoer die je vastlegt, verschijnen hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisane odczyty i wpisy pojawią się tutaj."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As leituras e os registos que fizeres vão aparecer aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Citirile și înregistrările pe care le faci vor apărea aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записанные измерения и записи появятся здесь."
          }
        }
      }
    },
    "Readings for the selected range appear here.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Messwerte für den ausgewählten Zeitraum erscheinen hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las lecturas del intervalo seleccionado aparecen aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mesures de la plage sélectionnée s'affichent ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le letture per l'intervallo selezionato appaiono qui."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Metingen voor het geselecteerde bereik verschijnen hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odczyty dla wybranego zakresu pojawią się tutaj."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As leituras do intervalo selecionado aparecem aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Citirile pentru intervalul selectat apar aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь появятся измерения за выбранный период."
          }
        }
      }
    },
    "Readings from %@ to %@ count as in range. These thresholds set the green / yellow / orange / red zones and your Time-in-Range statistics.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Messwerte von %@ bis %@ gelten als im Zielbereich. Diese Schwellenwerte legen die grünen / gelben / orangen / roten Zonen und deine Time-in-Range-Statistiken fest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las lecturas de %@ a %@ cuentan como en rango. Estos umbrales definen las zonas verde / amarilla / naranja / roja y tus estadísticas de tiempo en rango."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mesures de %@ à %@ comptent comme dans la cible. Ces seuils définissent les zones verte / jaune / orange / rouge et vos statistiques de temps dans la cible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le letture da %@ a %@ contano come nell'intervallo. Queste soglie impostano le zone verde / gialla / arancione / rossa e le tue statistiche di tempo nell'intervallo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Metingen van %@ tot %@ tellen als binnen bereik. Deze drempels bepalen de groene / gele / oranje / rode zones en je statistieken voor tijd binnen bereik."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odczyty od %@ do %@ liczą się jako w zakresie. Te progi wyznaczają zielone / żółte / pomarańczowe / czerwone strefy oraz Twoje statystyki czasu w zakresie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As leituras de %@ a %@ contam como dentro do intervalo. Estes limiares definem as zonas verde / amarela / laranja / vermelha e as tuas estatísticas de tempo dentro do intervalo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Citirile de la %@ la %@ contează ca fiind în interval. Aceste praguri stabilesc zonele verde / galben / portocaliu / roșu și statisticile tale de timp în interval."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Измерения от %@ до %@ считаются в диапазоне. Эти пороги задают зелёную / жёлтую / оранжевую / красную зоны и вашу статистику времени в диапазоне."
          }
        }
      }
    },
    "Readings from the last three hours appear here.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
