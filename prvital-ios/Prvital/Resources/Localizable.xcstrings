    "Show this screen to whoever is helping you. This is general bystander guidance, not medical advice — helpers should always call emergency services when in doubt." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeige diesen Bildschirm der Person, die dir hilft. Dies ist allgemeine Anleitung für Ersthelfende, keine medizinische Beratung — im Zweifel immer den Notruf wählen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra esta pantalla a quien te esté ayudando. Es una guía general para transeúntes, no un consejo médico: ante la duda, quien ayude debe llamar siempre a emergencias."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Montrez cet écran à la personne qui vous aide. Il s'agit de conseils généraux pour les témoins, pas d'un avis médical — en cas de doute, il faut toujours appeler les secours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra questa schermata a chi ti sta aiutando. È una guida generale per chi presta soccorso, non un consiglio medico: nel dubbio, chiamare sempre i soccorsi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat dit scherm zien aan wie je helpt. Dit is algemene hulp voor omstanders, geen medisch advies — bel bij twijfel altijd de hulpdiensten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokaż ten ekran osobie, która Ci pomaga. To ogólne wskazówki dla świadków, nie porada medyczna — w razie wątpliwości pomagający powinien zawsze wezwać pogotowie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra este ecrã a quem te estiver a ajudar. É orientação geral para quem presta socorro, não aconselhamento médico — em caso de dúvida, deve-se ligar sempre para a emergência."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arată acest ecran celui care te ajută. Sunt îndrumări generale pentru martori, nu sfaturi medicale — la orice îndoială, cel care ajută trebuie să sune la urgențe."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Покажите этот экран тому, кто вам помогает. Это общие рекомендации для окружающих, а не медицинская консультация — при сомнениях всегда следует вызывать скорую помощь."
          }
        }
      }
    },
    "Show your glucose and let you log insulin and carbs from your wrist. Nothing leaves your paired devices." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt deine Glukosewerte an und lässt dich Insulin und Kohlenhydrate direkt vom Handgelenk aus erfassen. Nichts verlässt deine gekoppelten Geräte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra tu glucosa y te permite registrar insulina y carbohidratos desde la muñeca. Nada sale de tus dispositivos vinculados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche votre glycémie et vous permet d'enregistrer l'insuline et les glucides depuis votre poignet. Rien ne quitte vos appareils associés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra il tuo glucosio e ti permette di registrare insulina e carboidrati dal polso. Niente esce dai tuoi dispositivi associati."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont je glucose en laat je insuline en koolhydraten vanaf je pols vastleggen. Er verlaat niets je gekoppelde apparaten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuje Twój poziom glukozy i pozwala zapisywać insulinę oraz węglowodany prosto z nadgarstka. Nic nie opuszcza Twoich sparowanych urządzeń."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra a tua glicose e permite-te registar insulina e hidratos de carbono a partir do pulso. Nada sai dos teus dispositivos emparelhados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Îți afișează glicemia și îți permite să înregistrezi insulina și carbohidrații direct de la încheietură. Nimic nu părăsește dispozitivele tale asociate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает уровень глюкозы и позволяет вносить данные об инсулине и углеводах прямо с запястья. Ничего не покидает ваши сопряжённые устройства."
          }
        }
      }
    },
    "Showing your most recent entries." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
