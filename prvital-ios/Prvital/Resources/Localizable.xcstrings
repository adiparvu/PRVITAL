    "Full card — glucagon spot & contacts — is on my phone: Prvital → Settings → Emergency card.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die vollständige Karte — Glukagon-Ort & Kontakte — ist auf meinem Telefon: Prvital → Einstellungen → Notfallkarte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tarjeta completa —dónde está el glucagón y contactos— está en mi teléfono: Prvital → Ajustes → Tarjeta de emergencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La carte complète — emplacement du glucagon et contacts — est sur mon téléphone : Prvital → Réglages → Carte d'urgence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scheda completa — posizione del glucagone e contatti — è sul mio telefono: Prvital → Impostazioni → Scheda di emergenza."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De volledige kaart — glucagonplek & contacten — staat op mijn telefoon: Prvital → Instellingen → Noodkaart."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pełna karta — miejsce glukagonu i kontakty — jest w moim telefonie: Prvital → Ustawienia → Karta ratunkowa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O cartão completo — local do glucagon e contactos — está no meu telemóvel: Prvital → Definições → Cartão de emergência."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cardul complet — locul glucagonului și contactele — este pe telefonul meu: Prvital → Setări → Card de urgență."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полная карточка — где глюкагон и контакты — в моём телефоне: Prvital → Настройки → Экстренная карточка."
          }
        }
      }
    },
