          }
        }
      }
    },
    "Your password is stored only in this device's Keychain and sent solely to the service to sign in.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Passwort wird nur im Schlüsselbund dieses Geräts gespeichert und ausschließlich zum Anmelden an den Dienst gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu contraseña se guarda solo en el Llavero de este dispositivo y se envía únicamente al servicio para iniciar sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre mot de passe est stocké uniquement dans le trousseau de cet appareil et envoyé seulement au service pour la connexion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua password viene conservata solo nel portachiavi di questo dispositivo e inviata unicamente al servizio per l'accesso."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je wachtwoord wordt alleen bewaard in de sleutelhanger van dit apparaat en uitsluitend naar de service verzonden om aan te melden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje hasło jest przechowywane wyłącznie w pęku kluczy tego urządzenia i wysyłane tylko do usługi w celu zalogowania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua palavra-passe é guardada apenas no porta-chaves deste dispositivo e enviada unicamente ao serviço para iniciar sessão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Parola ta este păstrată doar în brelocul acestui dispozitiv și trimisă exclusiv serviciului pentru autentificare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш пароль хранится только в связке ключей этого устройства и отправляется исключительно сервису для входа."
          }
        }
      }
    },
    "Your primary source labels every reading's provenance and wins when two sources report the same moment. You can change it at any time without losing data.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die primäre Quelle kennzeichnet die Herkunft jedes Messwerts und hat Vorrang, wenn zwei Quellen denselben Moment melden. Sie lässt sich jederzeit ändern, ohne Daten zu verlieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu fuente principal etiqueta la procedencia de cada lectura y tiene prioridad cuando dos fuentes informan del mismo momento. Puedes cambiarla en cualquier momento sin perder datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre source principale indique la provenance de chaque mesure et l'emporte lorsque deux sources rapportent le même instant. Vous pouvez la changer à tout moment sans perdre de données."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua origine principale etichetta la provenienza di ogni lettura e prevale quando due origini riportano lo stesso momento. Puoi cambiarla in qualsiasi momento senza perdere dati."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je primaire bron labelt de herkomst van elke meting en krijgt voorrang wanneer twee bronnen hetzelfde moment melden. Je kunt deze op elk moment wijzigen zonder gegevens te verliezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje główne źródło oznacza pochodzenie każdego odczytu i ma pierwszeństwo, gdy dwa źródła zgłaszają ten sam moment. Możesz je zmienić w każdej chwili bez utraty danych."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua fonte principal etiqueta a proveniência de cada leitura e prevalece quando duas fontes reportam o mesmo momento. Podes alterá-la a qualquer momento sem perder dados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sursa ta principală etichetează proveniența fiecărei citiri și are prioritate când două surse raportează același moment. O poți schimba oricând, fără a pierde date."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш основной источник помечает происхождение каждого измерения и имеет приоритет, когда два источника сообщают об одном и том же моменте. Вы можете изменить его в любой момент без потери данных."
          }
        }
      }
    },
    "Your records are health data. Handle exports and backups with the same care you'd give any medical information.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die eigenen Aufzeichnungen sind Gesundheitsdaten. Exporte und Backups mit derselben Sorgfalt behandeln wie jede andere medizinische Information."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus registros son datos de salud. Trata las exportaciones y las copias de seguridad con el mismo cuidado que darías a cualquier información médica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos enregistrements sont des données de santé. Traitez les exports et les sauvegardes avec le même soin que toute information médicale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi record sono dati sanitari. Gestisci esportazioni e backup con la stessa cura che riserveresti a qualsiasi informazione medica."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je registraties zijn gezondheidsgegevens. Behandel exports en back-ups met dezelfde zorg als je aan alle medische informatie zou geven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje rekordy to dane zdrowotne. Traktuj eksporty i kopie zapasowe z taką samą troską jak każdą informację medyczną."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os teus registos são dados de saúde. Trata as exportações e as cópias de segurança com o mesmo cuidado que darias a qualquer informação médica."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrările tale sunt date medicale. Tratează exporturile și copiile de rezervă cu aceeași grijă pe care ai acorda-o oricărei informații medicale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши записи — это медицинские данные. Обращайтесь с экспортами и резервными копиями так же бережно, как с любой медицинской информацией."
          }
        }
      }
    },
    "Your urgent low alert hasn't been acknowledged. Check your glucose and treat if needed. (Reminder %lld of %lld)": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Alarm für eine dringende Unterzuckerung wurde nicht bestätigt. Prüfe deine Glukose und behandle bei Bedarf. (Erinnerung %lld von %lld)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No has confirmado tu alerta de bajada urgente. Comprueba tu glucosa y trátala si es necesario. (Recordatorio %lld de %lld)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre alerte d'hypo urgente n'a pas été confirmée. Vérifiez votre glycémie et traitez si nécessaire. (Rappel %lld sur %lld)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo avviso di ipoglicemia urgente non è stato confermato. Controlla la glicemia e intervieni se necessario. (Promemoria %lld di %lld)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je waarschuwing voor een urgente hypo is niet bevestigd. Controleer je glucose en behandel indien nodig. (Herinnering %lld van %lld)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm o pilnym niedocukrzeniu nie został potwierdzony. Sprawdź glukozę i w razie potrzeby zareaguj. (Przypomnienie %lld z %lld)"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu alerta de baixa urgente não foi confirmado. Verifica a tua glicose e trata se necessário. (Lembrete %lld de %lld)"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerta ta de scădere urgentă nu a fost confirmată. Verifică-ți glicemia și tratează dacă e nevoie. (Reamintirea %lld din %lld)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше предупреждение о срочно низком уровне не подтверждено. Проверьте глюкозу и при необходимости примите меры. (Напоминание %lld из %lld)"
          }
        }
      }
    },
    "Your week in review covers the last full Monday–Sunday week. It appears once that week has readings on at least 3 days.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Wochenrückblick umfasst die letzte volle Woche von Montag bis Sonntag. Er erscheint, sobald diese Woche an mindestens 3 Tagen Messwerte hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu resumen de la semana cubre la última semana completa de lunes a domingo. Aparece cuando esa semana tiene lecturas en al menos 3 días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre bilan de la semaine couvre la dernière semaine complète du lundi au dimanche. Il apparaît dès que cette semaine compte des mesures sur au moins 3 jours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua settimana in sintesi copre l'ultima settimana completa da lunedì a domenica. Compare quando quella settimana ha letture in almeno 3 giorni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je weekoverzicht beslaat de laatste volledige week van maandag tot en met zondag. Het verschijnt zodra die week op minstens 3 dagen metingen heeft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podsumowanie tygodnia obejmuje ostatni pełny tydzień od poniedziałku do niedzieli. Pojawia się, gdy w tym tygodniu są odczyty z co najmniej 3 dni."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu resumo da semana cobre a última semana completa de segunda a domingo. Aparece quando essa semana tiver leituras em pelo menos 3 dias."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezumatul săptămânii acoperă ultima săptămână completă de luni până duminică. Apare când acea săptămână are citiri în cel puțin 3 zile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Итоги недели охватывают последнюю полную неделю с понедельника по воскресенье. Они появляются, когда за эту неделю есть измерения минимум за 3 дня."
          }
        }
      }
    },
