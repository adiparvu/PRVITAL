    "It took %lld rounds of %lld g to recover.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es brauchte %lld Runden mit je %lld g zur Erholung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hicieron falta %lld rondas de %lld g para recuperarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il a fallu %lld tours de %lld g pour remonter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci sono voluti %lld cicli da %lld g per riprendersi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er waren %lld rondes van %lld g nodig om te herstellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do wyrównania potrzeba było %lld rund po %lld g."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Foram precisas %lld rondas de %lld g para recuperar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "A fost nevoie de %lld runde a câte %lld g pentru revenire."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для восстановления потребовалось %lld подходов по %lld г."
          }
        }
      }
    },
    "It's been a while since your %lld g meal — a reading now shows how it landed.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine %lld-g-Mahlzeit ist schon eine Weile her – ein Messwert jetzt zeigt, wie sie sich ausgewirkt hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha pasado un rato desde tu comida de %lld g: una lectura ahora muestra cómo ha ido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre repas de %lld g remonte à un moment — une mesure maintenant montre son effet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È passato un po' dal tuo pasto da %lld g — una lettura ora mostra com'è andata."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is alweer even geleden sinds je maaltijd van %lld g — een meting nu laat zien hoe het uitpakte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Minęło już trochę czasu od Twojego posiłku %lld g — pomiar teraz pokaże, jak się skończył."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Já passou algum tempo desde a tua refeição de %lld g — uma leitura agora mostra como correu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "A trecut ceva timp de la masa ta de %lld g — o citire acum arată cum a decurs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С момента вашего приёма пищи на %lld г прошло время — измерение сейчас покажет результат."
          }
        }
      }
    },
    "It's been about %lldh since your last reading. A quick check keeps your trend complete.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine letzte Messung ist etwa %lld Std. her. Eine schnelle Kontrolle hält den Trend vollständig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Han pasado unas %lld h desde tu última lectura. Una comprobación rápida mantiene tu tendencia completa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il s'est écoulé environ %lld h depuis votre dernière mesure. Une vérification rapide garde votre tendance complète."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono passate circa %lld h dall'ultima lettura. Un controllo rapido mantiene completo il tuo andamento."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is ongeveer %lld u geleden sinds je laatste meting. Een snelle controle houdt je trend compleet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Od Twojego ostatniego odczytu minęło około %lld h. Szybki pomiar dopełnia Twój trend."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Passaram cerca de %lld h desde a tua última leitura. Uma verificação rápida mantém a tua tendência completa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Au trecut aproximativ %lld h de la ultima ta citire. O verificare rapidă îți menține tendința completă."
          }
        },
        "ru": {
          "stringUnit": {
