    "%@ and dropping quickly — keep fast carbs handy." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ und fällt schnell — halte schnelle Kohlenhydrate bereit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ y bajando rápidamente — ten a mano carbohidratos de acción rápida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ et en baisse rapide — garde des sucres rapides à portée de main."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ e in rapido calo — tieni a portata di mano carboidrati ad azione rapida."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ en daalt snel — houd snelle koolhydraten bij de hand."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ i szybko spada — miej pod ręką szybkie węglowodany."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ e a descer rapidamente — tem hidratos de carbono de absorção rápida à mão."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ și scade rapid — ține la îndemână carbohidrați cu absorbție rapidă."
