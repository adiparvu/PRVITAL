    "After more sleep, your glucose tends to run higher." : {
      "extractionState" : "manual",
      "localizations" : {
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "După mai mult somn, glicemia tinde să fie mai mare."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach mehr Schlaf ist dein Glukosewert tendenziell höher."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras dormir más, tu glucosa suele ser más alta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après plus de sommeil, votre glycémie a tendance à être plus élevée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo aver dormito di più, la glicemia tende a essere più alta."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na meer slaap is je glucose meestal hoger."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po dłuższym śnie glikemia zwykle jest wyższa."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois de dormir mais, a tua glicose tende a ser mais alta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После более долгого сна глюкоза обычно выше."
          }
        }
      }
    },
    "After more sleep, your glucose tends to run lower." : {
      "extractionState" : "manual",
