    "Your glucose may drop below range in about %lld min. A quick check or a small snack can head it off.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Glukose könnte in etwa %lld Min. unter den Zielbereich fallen. Eine schnelle Messung oder ein kleiner Snack kann das verhindern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu glucosa podría bajar por debajo del rango en unos %lld min. Una comprobación rápida o un pequeño tentempié puede evitarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre glycémie pourrait descendre sous la cible dans environ %lld min. Une mesure rapide ou une petite collation peut l'éviter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua glicemia potrebbe scendere sotto l'intervallo tra circa %lld min. Un controllo rapido o un piccolo spuntino può evitarlo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je glucose kan over ongeveer %lld min onder bereik zakken. Een snelle controle of een klein tussendoortje kan dit voorkomen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja glukoza może spaść poniżej zakresu za około %lld min. Szybki pomiar lub mała przekąska może temu zapobiec."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua glicose pode descer abaixo do intervalo dentro de cerca de %lld min. Uma verificação rápida ou um pequeno lanche pode evitá-lo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Glicemia ta ar putea scădea sub interval în aproximativ %lld min. O verificare rapidă sau o gustare mică poate preveni acest lucru."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша глюкоза может опуститься ниже диапазона примерно через %lld мин. Быстрая проверка или лёгкий перекус помогут этого избежать."
          }
        }
      }
    },
    "Your journal is stored locally and encrypted at rest.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Journal wird lokal gespeichert und im Ruhezustand verschlüsselt."
