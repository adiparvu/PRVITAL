            "state": "translated",
            "value": "Przypomnienia pomogą ci trzymać się planu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os lembretes podem ajudar-te a manteres-te no bom caminho."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Reamintirile te pot ajuta să rămâi pe drumul cel bun."
